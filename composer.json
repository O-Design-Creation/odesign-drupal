{
    "name": "atelierodesign/odesign-drupal",
    "description": "O'Design Création Drupal",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "DDEV User",
            "email": "nobody@example.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drush/drush": "^13",
        "drupal/commerce": "^3",
        "drupal/inline_entity_form": "^3@RC",
        "drupal/search_api": "^1",
        "drupal/metatag": "^2",
        "drupal/redirect": "^1",
        "drupal/commerce_stripe": "^2.2",
        "drupal/gin": "^5.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/field_group": "^4.0",
        "drupal/commerce_shipping": "^3.0",
        "drupal/smtp": "^1.4",
        "drupal/mailsystem": "^4.5",
        "drupal/commerce_invoice": "^2.2",
        "drupal/config_ignore": "^3.3",
        "drupal/eu_cookie_compliance": "^1.29",
        "drupal/pathauto": "^1.14",
        "drupal/simple_sitemap": "^4.2",
        "drupal/facets": "^3.0",
        "drupal/chosen": "^4.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "bower-asset/chosen": "^1.8",
        "drupal/default_content": "^2.0.0-beta1",
        "drupal/default_content_deploy": "^2.1",
        "drupal/scheduler": "^2.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/contact_storage": "^1.5",
        "drupal/simplenews": "^4.1",
        "drupal/robotstxt": "^1.6",
        "erusev/parsedown": "^1.8",
        "drupal/search_api_autocomplete": "^1.11",
        "drupal/google_tag": "^2.0",
        "drupal/social_auth": "^4.1",
        "drupal/social_auth_google": "^4.0",
        "drupal/commerce_shipping_mondial_relay": "^1.0",
        "drupal/ai": "^1.3",
        "drupal/core": "^11"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true
        },
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ]
    }
}
