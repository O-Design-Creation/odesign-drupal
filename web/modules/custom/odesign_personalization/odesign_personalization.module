<?php

/**
 * @file
 * ODesign Personalization — système natif de personnalisation produit.
 *
 * Architecture :
 *   - PersonalizationTemplate : config entity géré par le gestionnaire boutique.
 *   - field_personalization_template : référence au template sur commerce_product.
 *   - field_personalization_values : JSON des valeurs soumises sur commerce_order_item.
 *   - PersonalizationPriceResolver : calcule les modificateurs de prix Commerce.
 *   - hook_form_alter : injecte le formulaire de perso dans add_to_cart.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\commerce_order\Entity\OrderItemInterface;
use Drupal\odesign_personalization\Entity\PersonalizationTemplate;
use Drupal\odesign_personalization\PersonalizationValues;

/**
 * Implements hook_form_FORM_ID_alter() for add_to_cart forms.
 *
 * Injecte les champs de personnalisation définis dans le template du produit.
 */
function odesign_personalization_form_commerce_order_item_add_to_cart_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id
): void {
  // Récupérer le produit depuis le form object.
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }
  $orderItem = $formObject->getEntity();
  if (!$orderItem instanceof OrderItemInterface) {
    return;
  }

  $purchasedEntity = $orderItem->getPurchasedEntity();
  if (!$purchasedEntity) {
    return;
  }

  // Remonter au produit parent.
  $product = NULL;
  if (method_exists($purchasedEntity, 'getProduct')) {
    $product = $purchasedEntity->getProduct();
  }
  if (!$product instanceof ProductInterface) {
    return;
  }

  if (!$product->hasField('field_personalization_template') || $product->get('field_personalization_template')->isEmpty()) {
    return;
  }

  /** @var \Drupal\odesign_personalization\Entity\PersonalizationTemplate $template */
  $template = $product->get('field_personalization_template')->entity;
  if (!$template) {
    return;
  }

  $fields = $template->getFields();
  if (empty($fields)) {
    return;
  }

  // Attacher la librairie JS (live price update)
  $form['#attached']['library'][] = 'odesign_personalization/frontend';
  $form['#attached']['drupalSettings']['odesign_personalization'] = [
    'templateId'   => $template->id(),
    'basePrice'    => (float) $orderItem->getUnitPrice()?->getNumber(),
    'hasPriceModifiers' => $template->hasPriceModifiers(),
  ];

  // Conteneur personnalisation
  $form['personalization'] = [
    '#type'       => 'fieldset',
    '#title'      => t('Personnalisation'),
    '#attributes' => ['class' => ['personalization-fields'], 'data-template' => $template->id()],
    '#weight'     => 50,
  ];

  $prenom_field_keys = [];
  $wall_mount_field_key = NULL;
  $field_labels_by_key = [];

  foreach ($fields as $field) {
    $fieldId  = $field['id'];
    $fieldKeyBase = 'perso_' . preg_replace('/[^a-z0-9_]/i', '_', strtolower($field['label'] ?: $fieldId));
    $fieldKey = $fieldKeyBase;
    $fieldKeySuffix = 2;
    while (isset($field_labels_by_key[$fieldKey])) {
      $fieldKey = $fieldKeyBase . '_' . $fieldKeySuffix;
      $fieldKeySuffix++;
    }
    $normalized_label = mb_strtolower(trim((string) ($field['label'] ?? '')));
    $field_labels_by_key[$fieldKey] = (string) ($field['label'] ?? '');

    if (str_contains($normalized_label, 'prénom') || str_contains($normalized_label, 'prenom') || str_contains($normalized_label, 'prénoms') || str_contains($normalized_label, 'prenoms')) {
      $prenom_field_keys[] = $fieldKey;
    }
    if (
      str_contains($normalized_label, 'attache')
      && (str_contains($normalized_label, 'murale') || str_contains($normalized_label, 'mur'))
    ) {
      $wall_mount_field_key = $fieldKey;
    }

    $baseProps = [
      '#title'       => $field['label'],
      '#required'    => !empty($field['required']),
      '#description' => $field['help'] ?? '',
      '#attributes'  => [
        'data-perso-field' => $fieldId,
        'data-price-mod-type'   => $field['price_modifier']['type'] ?? 'none',
        'data-price-mod-amount' => $field['price_modifier']['amount'] ?? '0',
      ],
    ];

    if (!empty($field['placeholder'])) {
      $baseProps['#placeholder'] = $field['placeholder'];
    }
    if (!empty($field['maxlength'])) {
      $baseProps['#maxlength'] = (int) $field['maxlength'];
    }

    switch ($field['type']) {
      case 'textarea':
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type' => 'textarea',
          '#rows' => 3,
        ];
        break;

      case 'select':
        $options = ['_none' => t('-- Choisir --')];
        foreach ($field['options'] ?? [] as $opt) {
          $options[$opt['value']] = $opt['label'];
        }
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type'    => 'select',
          '#options' => $options,
        ];
        break;

      case 'radio':
        $options = [];
        foreach ($field['options'] ?? [] as $opt) {
          $options[$opt['value']] = $opt['label'];
        }
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type'    => 'radios',
          '#options' => $options,
        ];
        break;

      case 'checkboxes':
        $options = [];
        foreach ($field['options'] ?? [] as $opt) {
          $options[$opt['value']] = $opt['label'];
        }
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type'    => 'checkboxes',
          '#options' => $options,
        ];
        break;

      case 'file':
        $fileProps = $baseProps;
        if (!empty($field['placeholder'])) {
          $fileProps['#description'] = trim($field['placeholder'] . (!empty($field['help']) ? ' — ' . $field['help'] : ''));
        }
        $form['personalization'][$fieldKey] = $fileProps + [
          '#type'              => 'managed_file',
          '#upload_location'   => 'private://personalization/',
          '#upload_validators' => [
            'file_validate_extensions' => ['jpg jpeg png pdf'],
            'file_validate_size'       => [10 * 1024 * 1024],
          ],
        ];
        break;

      case 'number':
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type' => 'number',
          '#min'  => 0,
        ];
        break;

      case 'date':
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type' => 'date',
        ];
        break;

      case 'repeatable_group':
        // Groupe répétable : injecté comme conteneur avec sous-champs.
        $groupMax = (int) ($field['group_max'] ?? 5);
        $currentCount = (int) ($form_state->get('group_count_' . $fieldKey) ?? 1);
        $form['personalization'][$fieldKey . '_group'] = [
          '#type'       => 'fieldset',
          '#title'      => $field['label'],
          '#attributes' => ['id' => 'group-' . $fieldKey],
          '#description' => $field['help'] ?? '',
        ];
        for ($i = 0; $i < $currentCount; $i++) {
          foreach ($field['group_fields'] ?? [] as $subField) {
            $subKey = $fieldKey . '_' . $i . '_' . preg_replace('/[^a-z0-9_]/i', '_', strtolower($subField['id']));
            $form['personalization'][$fieldKey . '_group'][$subKey] = [
              '#type'        => 'textfield',
              '#title'       => $subField['label'] . ' ' . ($i + 1),
              '#required'    => !empty($subField['required']),
              '#placeholder' => $subField['placeholder'] ?? '',
              '#attributes'  => ['data-perso-group' => $fieldKey, 'data-group-index' => $i],
            ];
          }
        }
        if ($currentCount < $groupMax) {
          $form['personalization'][$fieldKey . '_add'] = [
            '#type'   => 'submit',
            '#value'  => t('+ Ajouter'),
            '#name'   => 'add_group_' . $fieldKey,
            '#submit' => ['odesign_personalization_add_group_item'],
            '#ajax'   => [
              'callback' => 'odesign_personalization_group_ajax',
              'wrapper'  => 'group-' . $fieldKey,
            ],
            '#limit_validation_errors' => [],
          ];
        }
        break;

      default: // text
        $form['personalization'][$fieldKey] = $baseProps + [
          '#type' => 'textfield',
        ];
        break;
    }

    // Libellé modificateur de prix sous le champ
    $mod = $field['price_modifier'] ?? [];
    if (!empty($mod['type']) && $mod['type'] !== 'none' && !empty($mod['amount'])) {
      $modLabel = !empty($mod['label']) ? $mod['label'] : '+ ' . $mod['amount'] . ' €';
      $form['personalization'][$fieldKey . '_price_hint'] = [
        '#markup' => '<div class="perso-price-hint" data-perso-field="' . htmlspecialchars($fieldId) . '">'
          . t('Supplément si renseigné : <strong>@label</strong>', ['@label' => $modLabel])
          . '</div>',
        '#weight' => $form['personalization'][$fieldKey]['#weight'] ?? 0 + 0.1,
      ];
    }
  }

  // Cas "Arbre de vie" / multi-prénoms :
  // regroupe les champs prénoms ensemble et place l'option attache murale
  // à côté du bloc pour rendre la saisie plus lisible côté client.
  if (odesign_personalization_should_use_tree_builder($product) && count($prenom_field_keys) >= 1) {
    $allowed_tree_keys = array_values(array_filter(array_unique(array_merge(
      $prenom_field_keys,
      $wall_mount_field_key ? [$wall_mount_field_key] : []
    ))));

    // Pour cet article, seule la saisie des prénoms (et option murale) est utile.
    foreach (array_keys($form['personalization']) as $child_key) {
      if (!is_string($child_key) || strpos($child_key, 'perso_') !== 0) {
        continue;
      }
      if (in_array($child_key, $allowed_tree_keys, TRUE) || $child_key === 'perso_tree_slot_map') {
        continue;
      }
      unset($form['personalization'][$child_key]);
      $hint_key = $child_key . '_price_hint';
      if (isset($form['personalization'][$hint_key])) {
        unset($form['personalization'][$hint_key]);
      }
    }

    $form['personalization']['tree_personalization_group'] = [
      '#type' => 'container',
      '#weight' => 15,
      '#attributes' => ['class' => ['tree-personalization-group']],
      'intro' => [
        '#markup' => '<p class="tree-personalization-group__intro">' . t('Arbre de vie : renseignez les prénoms dans l’ordre souhaité de placement.') . '</p>',
      ],
      'names' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['tree-personalization-group__names']],
      ],
      'wall_mount' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['tree-personalization-group__wall']],
      ],
      'builder' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['tree-personalization-group__builder']],
        'title' => [
          '#markup' => '<h3 class="tree-personalization-group__builder-title">' . t('Placement guidé des prénoms') . '</h3>',
        ],
        'help' => [
          '#markup' => '<p class="tree-personalization-group__builder-help">' . t('Les emplacements s’ajustent automatiquement au nombre de prénoms, de façon symétrique.') . '</p>',
        ],
        'instructions' => [
          '#markup' => '<p class="tree-personalization-group__builder-help tree-personalization-group__builder-help--instructions">' . t('Pour déplacer un prénom : cliquez son étiquette, puis cliquez le cœur souhaité. Cliquez un cœur déjà rempli sans prénom sélectionné pour le libérer.') . '</p>',
        ],
        'chips' => [
          '#markup' => '<div class="tree-personalization-group__chips js-tree-chips"></div>',
        ],
        'status' => [
          '#markup' => '<p class="tree-personalization-group__status js-tree-status" aria-live="polite"></p>',
        ],
        'stage' => [
          '#markup' => '<div class="tree-personalization-group__stage js-tree-stage"></div>',
        ],
      ],
    ];

    foreach ($prenom_field_keys as $key) {
      if (!isset($form['personalization'][$key])) {
        continue;
      }
      $form['personalization'][$key]['#title'] = t('Prénoms');
      $current_max = (int) ($form['personalization'][$key]['#maxlength'] ?? 0);
      $form['personalization'][$key]['#maxlength'] = max(500, $current_max);
      $form['personalization'][$key]['#placeholder'] = t('Ex: Emma, Louis, Jade');
      $form['personalization'][$key]['#description'] = t('Saisissez de 1 à 25 prénoms, séparés par des virgules.');
      $form['personalization'][$key]['#attributes']['data-tree-name-source'] = '1';
      $form['personalization']['tree_personalization_group']['names'][$key] = $form['personalization'][$key];
      unset($form['personalization'][$key]);

      $hint_key = $key . '_price_hint';
      if (isset($form['personalization'][$hint_key])) {
        $form['personalization']['tree_personalization_group']['names'][$hint_key] = $form['personalization'][$hint_key];
        unset($form['personalization'][$hint_key]);
      }
    }

    if ($wall_mount_field_key && isset($form['personalization'][$wall_mount_field_key])) {
      $form['personalization'][$wall_mount_field_key]['#attributes']['class'][] = 'js-tree-wall-mount-source';
      $form['personalization']['tree_personalization_group']['wall_mount'][$wall_mount_field_key] = $form['personalization'][$wall_mount_field_key];
      unset($form['personalization'][$wall_mount_field_key]);

      $hint_key = $wall_mount_field_key . '_price_hint';
      if (isset($form['personalization'][$hint_key])) {
        $form['personalization']['tree_personalization_group']['wall_mount'][$hint_key] = $form['personalization'][$hint_key];
        unset($form['personalization'][$hint_key]);
      }

      $label = $field_labels_by_key[$wall_mount_field_key] ?? '';
      $form['personalization']['tree_personalization_group']['wall_mount']['help'] = [
        '#markup' => '<p class="tree-personalization-group__wall-help">' . t('Option @label : cochez si vous souhaitez une fixation murale.', ['@label' => $label !== '' ? $label : t('attache murale')]) . '</p>',
      ];
    }

    // Mapping exploitable côté atelier : "Sxx -> prénom", alimenté par le JS.
    $form['personalization']['perso_tree_slot_map'] = [
      '#type' => 'hidden',
      '#default_value' => '',
      '#attributes' => ['class' => ['js-tree-slot-map']],
    ];
    $form['odesign_personalization_data'] = [
      '#type' => 'hidden',
      '#default_value' => '',
      '#attributes' => ['class' => ['js-tree-data-payload']],
      '#parents' => ['data', 'odesign_personalization_values'],
    ];

    // Un produit personnalisé ne doit pas être fusionné automatiquement.
    if (isset($form['settings']['combine'])) {
      $form['settings']['combine']['#type'] = 'value';
      $form['settings']['combine']['#value'] = FALSE;
    }
  }

  // Prix dynamique
  if ($template->hasPriceModifiers()) {
    $form['personalization']['price_summary'] = [
      '#markup' => '<div class="perso-price-summary" aria-live="polite"></div>',
      '#weight' => 100,
    ];
  }

  // Submit handler pour sauvegarder les valeurs perso dans l'order_item.
  $form['#submit'][] = 'odesign_personalization_add_to_cart_submit';
  if (isset($form['actions']) && is_array($form['actions'])) {
    foreach ($form['actions'] as &$action) {
      if (is_array($action) && (($action['#type'] ?? '') === 'submit')) {
        $action['#submit'][] = 'odesign_personalization_add_to_cart_submit';
      }
    }
    unset($action);
  }
}

/**
 * Limite le builder "Arbre de vie" aux produits qui l'utilisent réellement.
 */
function odesign_personalization_should_use_tree_builder(ProductInterface $product): bool {
  $tree_handles = [
    '/products/arbre-de-vie-personnalise',
  ];

  $product_path = '/product/' . $product->id();
  $alias_manager = \Drupal::service('path_alias.manager');

  foreach ($tree_handles as $expected_alias) {
    if ($alias_manager->getPathByAlias($expected_alias) === $product_path) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Custom submit handler — persiste les valeurs perso dans field_personalization_values.
 */
function odesign_personalization_add_to_cart_submit(array $form, FormStateInterface $form_state): void {
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }
  $orderItem = $formObject->getEntity();
  if (!$orderItem instanceof OrderItemInterface) {
    return;
  }

  // Collecter récursivement toutes les valeurs des champs perso_*.
  $sources = [
    (array) $form_state->getValues(),
    (array) $form_state->getValue('personalization', []),
    (array) $form_state->getUserInput(),
    (array) (($form_state->getUserInput()['personalization'] ?? [])),
  ];
  $values = [];
  foreach ($sources as $source) {
    $values += PersonalizationValues::collectFromInput($source);
  }

  if ($values) {
    PersonalizationValues::set($orderItem, $values);
  }
  if ($values && !$orderItem->isNew()) {
    $orderItem->save();
  }
}

/**
 * Implements hook_form_FORM_ID_submit() for add_to_cart forms.
 */
function odesign_personalization_form_commerce_order_item_add_to_cart_form_submit(array $form, FormStateInterface $form_state): void {
  odesign_personalization_add_to_cart_submit($form, $form_state);
}

/**
 * Collecte récursive des valeurs perso_* depuis l'arbre des valeurs du form.
 */
function odesign_personalization_collect_perso_values(array $input): array {
  return PersonalizationValues::collectFromInput($input);
}

/**
 * AJAX callback pour les groupes répétables.
 */
function odesign_personalization_group_ajax(array &$form, FormStateInterface $form_state): array {
  $trigger = $form_state->getTriggeringElement();
  $fieldKey = str_replace('add_group_', '', $trigger['#name'] ?? '');
  return $form['personalization'][$fieldKey . '_group'] ?? [];
}

/**
 * Submit handler pour "Ajouter" dans un groupe répétable.
 */
function odesign_personalization_add_group_item(array &$form, FormStateInterface $form_state): void {
  $trigger = $form_state->getTriggeringElement();
  $fieldKey = str_replace('add_group_', '', $trigger['#name'] ?? '');
  $count = (int) $form_state->get('group_count_' . $fieldKey) ?: 1;
  $form_state->set('group_count_' . $fieldKey, $count + 1);
  $form_state->setRebuild();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for commerce_order_item.
 *
 * S'assure que field_personalization_values est bien un JSON valide.
 */
function odesign_personalization_commerce_order_item_presave(EntityInterface $entity): void {
  if (!$entity instanceof OrderItemInterface) {
    return;
  }
  $values = PersonalizationValues::get($entity);
  if (!$values) {
    return;
  }
  PersonalizationValues::set($entity, $values);
}

/**
 * Implements hook_entity_view().
 *
 * Ajoute une synthèse "atelier" lisible pour l'Arbre de vie dans les lignes
 * de commande quand un mapping de slots est disponible.
 */
function odesign_personalization_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if (!$entity instanceof OrderItemInterface) {
    return;
  }
  $values = PersonalizationValues::get($entity);
  if (!$values) {
    return;
  }

  $slotMap = (string) ($values['Plan de pose prénoms'] ?? '');
  if ($slotMap === '') {
    return;
  }

  $rows = array_values(array_filter(array_map('trim', preg_split('/\r\n|\r|\n/', $slotMap) ?: [])));
  if (!$rows) {
    return;
  }

  $items = '';
  foreach ($rows as $row) {
    $items .= '<li>' . htmlspecialchars($row, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</li>';
  }

  $build['odesign_tree_summary'] = [
    '#type' => 'container',
    '#weight' => 90,
    '#attributes' => ['class' => ['odesign-tree-summary']],
    'title' => [
      '#markup' => '<p class="odesign-tree-summary__title">' . t('Plan de pose prénoms') . '</p>',
    ],
    'list' => [
      '#markup' => '<ul class="odesign-tree-summary__list">' . $items . '</ul>',
    ],
  ];
}

/**
 * Implements hook_preprocess_commerce_checkout_order_summary().
 *
 * Expose une vue lisible des personnalisations JSON dans le template checkout.
 */
function odesign_personalization_preprocess_commerce_checkout_order_summary(array &$variables): void {
  if (empty($variables['order_entity'])) {
    return;
  }

  $items = $variables['order_entity']->getItems();
  $personalizations = [];

  foreach ($items as $orderItem) {
    if (!$orderItem instanceof OrderItemInterface) {
      continue;
    }
    $decoded = PersonalizationValues::get($orderItem);
    if (!$decoded) {
      continue;
    }

    $rows = [];
    foreach ($decoded as $label => $value) {
      if (!is_scalar($value)) {
        continue;
      }
      $stringValue = trim((string) $value);
      if ($stringValue === '') {
        continue;
      }

      if ($label === 'Plan de pose prénoms') {
        $lines = array_values(array_filter(array_map('trim', preg_split('/\r\n|\r|\n/', $stringValue) ?: [])));
        if ($lines) {
          $rows[] = [
            'label' => $label,
            'value' => $lines,
            'is_list' => TRUE,
          ];
        }
        continue;
      }

      $rows[] = [
        'label' => $label,
        'value' => $stringValue,
        'is_list' => FALSE,
      ];
    }

    if ($rows) {
      $personalizations[$orderItem->id()] = $rows;
    }
  }

  $variables['odesign_personalizations'] = $personalizations;
}
