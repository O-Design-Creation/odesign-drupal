{#
/**
 * @file
 * Template du tableau de bord gestionnaire boutique — ODesign Admin.
 *
 * Variables :
 * - cards          : array — tuiles de stats déclarées via hook_odesign_boutique_dashboard_cards_alter()
 *                    Chaque card : title, value, url, icon (Phosphor), highlight, weight
 * - alert_messages : array — bandeaux d'alerte {type, message}
 * - orders_url     : URL vers toutes les commandes
 * - orders_view    : render array de la vue commandes
 * - recent_articles: array de {title, edit_url, view_url, date, status}
 */
#}

<div class="odesign-dashboard">

  {# Bandeaux d'alerte (clés manquantes, config incomplète) #}
  {% if alert_messages is not empty %}
    <div class="odesign-dashboard__alerts">
      {% for alert in alert_messages %}
        <div class="odesign-dashboard__alert odesign-dashboard__alert--{{ alert.type }}" role="alert">
          <i class="ph ph-warning" aria-hidden="true"></i>
          <span>{{ alert.message|raw }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# Bannière d'accueil #}
  <div class="odesign-dashboard__welcome">
    <i class="ph ph-storefront odesign-dashboard__welcome-icon" aria-hidden="true"></i>
    <div class="odesign-dashboard__welcome-text">
      <h2>Bienvenue dans votre boutique</h2>
      <p>Retrouvez ici vos commandes, vos produits et toutes les actions du quotidien.</p>
    </div>
  </div>

  {# Tuiles de statistiques (hook-driven) #}
  {% if cards is not empty %}
    <div class="odesign-dashboard__stats">
      {% for card in cards %}
        <a href="{{ card.url }}" class="odesign-dashboard__stat odesign-dashboard__stat--link{% if card.highlight %} odesign-dashboard__stat--highlight{% endif %}">
          <i class="ph {{ card.icon }} stat-icon" aria-hidden="true"></i>
          <span class="stat-value">{{ card.value }}</span>
          <span class="stat-label">{{ card.title }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# Top produits vendus — section dédiée #}
  {% if top_products is not empty %}
    <div class="odesign-dashboard__top-products">
      <div class="odesign-dashboard__section-header">
        <h3>
          <i class="ph ph-trophy" aria-hidden="true"></i>
          Top produits vendus
        </h3>
        <a href="/admin/commerce/products" class="odesign-dashboard__see-all">Voir tous les produits →</a>
      </div>
      <ol class="odesign-top-products__list" aria-label="Classement des produits les plus vendus">
        {% for product in top_products %}
          <li class="odesign-top-products__item">
            <span class="odesign-top-products__rank" aria-hidden="true">{{ loop.index }}</span>
            <span class="odesign-top-products__title">{{ product.title }}</span>
            <span class="odesign-top-products__count">
              <strong>{{ product.cnt }}</strong>
              <span class="odesign-top-products__count-label">{{ product.cnt > 1 ? 'ventes' : 'vente' }}</span>
            </span>
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endif %}

  {# Commandes récentes — pleine largeur, section principale #}
  {% if orders_view %}
    <div class="odesign-dashboard__orders odesign-dashboard__orders--full">
      <div class="odesign-dashboard__section-header">
        <h3>
          <i class="ph ph-receipt" aria-hidden="true"></i>
          Commandes récentes
        </h3>
        <a href="{{ orders_url }}" class="odesign-dashboard__see-all">Voir toutes les commandes →</a>
      </div>
      {{ orders_view }}
    </div>
  {% endif %}

  {# Articles récents — grille 2 colonnes sous les commandes #}
  {% if recent_articles is not empty %}
    <div class="odesign-dashboard__recent-articles">
      <div class="odesign-dashboard__section-header">
        <h3>
          <i class="ph ph-article" aria-hidden="true"></i>
          Articles récents
        </h3>
        <a href="/admin/content?type=article" class="odesign-dashboard__see-all">Voir tous les articles →</a>
      </div>
      <div class="odesign-dashboard__article-list">
        {% for article in recent_articles %}
          <div class="odesign-dashboard__article-item">
            <div class="article-item__info">
              <a href="{{ article.edit_url }}" class="article-item__title">{{ article.title }}</a>
              <span class="article-item__date">{{ article.date }}</span>
            </div>
            <div class="article-item__actions">
              <span class="article-item__status {{ article.status ? 'status--published' : 'status--draft' }}">
                {{ article.status ? 'Publié' : 'Brouillon' }}
              </span>
              <a href="{{ article.view_url }}" class="article-item__btn article-item__btn--view" title="Voir l'article" target="_blank" rel="noopener noreferrer">
                <i class="ph ph-eye" aria-hidden="true"></i>
              </a>
              <a href="{{ article.edit_url }}" class="article-item__btn article-item__btn--edit" title="Modifier l'article">
                <i class="ph ph-pencil" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="odesign-dashboard__article-footer">
        <a href="/node/add/article" class="odesign-dashboard__new-article-btn">
          <i class="ph ph-plus" aria-hidden="true"></i>
          Écrire un nouvel article
        </a>
      </div>
    </div>
  {% else %}
    <div class="odesign-dashboard__recent-articles odesign-dashboard__recent-articles--empty">
      <h3>
        <i class="ph ph-article" aria-hidden="true"></i>
        Blog
      </h3>
      <p>Aucun article publié pour l'instant.</p>
      <a href="/node/add/article" class="odesign-dashboard__new-article-btn">
        <i class="ph ph-plus" aria-hidden="true"></i>
        Écrire votre premier article
      </a>
    </div>
  {% endif %}

</div>
