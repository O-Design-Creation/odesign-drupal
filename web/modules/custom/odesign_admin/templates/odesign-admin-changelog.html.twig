{#
/**
 * @file
 * Template pour le journal des nouveautés (changelog gestionnaire).
 *
 * Variables :
 *   - content : contenu HTML rendu depuis CHANGELOG-gestionnaire.md
 *   - version : numéro de version déployé (APP_VERSION), peut être NULL
 */
#}

<div class="odesign-changelog">

  <header class="odesign-changelog__header">
    <h1 class="odesign-changelog__title">
      <i class="ph ph-clock-counter-clockwise"></i>
      Nouveautés &amp; corrections
    </h1>
    {% if version %}
      <span class="odesign-changelog__version-badge">
        Version déployée : <strong>{{ version }}</strong>
      </span>
    {% endif %}
    <p class="odesign-changelog__intro">
      Retrouvez ici les dernières améliorations apportées à votre espace de gestion,
      expliquées sans jargon technique.
    </p>
  </header>

  <div class="odesign-changelog__body odesign-documentation__markdown prose">
    {{ content|raw }}
  </div>

</div>

<style>
.odesign-changelog {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
  font-family: var(--font-sans, system-ui, sans-serif);
}

.odesign-changelog__header {
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid #e5e7eb;
}

.odesign-changelog__title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0 0 .75rem;
  display: flex;
  align-items: center;
  gap: .5rem;
}

.odesign-changelog__version-badge {
  display: inline-block;
  background: #f0fdf4;
  border: 1px solid #86efac;
  color: #166534;
  padding: .25rem .75rem;
  border-radius: 999px;
  font-size: .85rem;
  margin-bottom: .75rem;
}

.odesign-changelog__intro {
  color: #6b7280;
  margin: .5rem 0 0;
  font-size: .95rem;
}

.odesign-changelog__body h2 {
  font-size: 1.15rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 2rem 0 .5rem;
  padding: .5rem .75rem;
  background: #f9fafb;
  border-left: 4px solid #6366f1;
  border-radius: 0 4px 4px 0;
}

.odesign-changelog__body h3 {
  font-size: 1rem;
  font-weight: 600;
  color: #374151;
  margin: 1.25rem 0 .4rem;
}

.odesign-changelog__body ul {
  margin: .4rem 0 1rem 1.25rem;
  line-height: 1.7;
}

.odesign-changelog__body hr {
  border: none;
  border-top: 1px solid #e5e7eb;
  margin: 1.5rem 0;
}

.odesign-changelog__body strong {
  font-weight: 600;
  color: #111827;
}
</style>
