<?php

/**
 * @file
 * ODesign Admin — tableau de bord, aide contextuelle, redirection post-login.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;

/**
 * Implémente hook_page_attachments().
 *
 * Injecte les CSS admin via html_head (contourne le système de library
 * qui ne sort pas le link tag dans ce contexte avec Gin).
 * Charge Phosphor (self-hosted dans odesign_base) à la place du CDN Google.
 */
function odesign_admin_page_attachments(array &$attachments): void {
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  // Phosphor Icons — self-hosted dans odesign_base (D-07 : migrer de Material Symbols).
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag'  => 'link',
      '#attributes' => [
        'rel'   => 'stylesheet',
        'href'  => '/themes/custom/odesign_base/css/phosphor.css',
        'media' => 'all',
      ],
    ],
    'odesign_admin_phosphor_css',
  ];

  // CSS nav admin (scopé : barre de navigation uniquement).
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag'  => 'link',
      '#attributes' => [
        'rel'   => 'stylesheet',
        'href'  => '/modules/custom/odesign_admin/css/admin-nav.css',
        'media' => 'all',
      ],
    ],
    'odesign_admin_nav_css',
  ];

  // JS nav admin — groupes déroulants.
  $attachments['#attached']['library'][] = 'odesign_admin/admin_nav';

  // CSS global admin (hors nav — views, forms, Gin overrides).
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag'  => 'link',
      '#attributes' => [
        'rel'   => 'stylesheet',
        'href'  => '/modules/custom/odesign_admin/css/admin-global.css',
        'media' => 'all',
      ],
    ],
    'odesign_admin_global_css',
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag'  => 'script',
      '#attributes' => [
        'src'   => '/modules/custom/odesign_admin/js/admin-actions.js',
        'defer' => TRUE,
      ],
    ],
    'odesign_admin_actions_js',
  ];
}

/**
 * Implémente hook_preprocess_html().
 *
 * Ajoute la classe CSS `odesign-gestionnaire` sur le body quand l'utilisateur
 * courant est gestionnaire_boutique (sans être admin).
 * Cette classe masque la toolbar Gin via CSS.
 *
 * Injecte aussi un inline CSS critique en <head> pour masquer la toolbar
 * avant que le browser n'affiche le rendu (évite le flash FOUC).
 */
function odesign_admin_preprocess_html(array &$variables): void {
  $account = \Drupal::currentUser();
  if (!$account->hasRole('gestionnaire_boutique') || $account->hasRole('administrator')) {
    return;
  }

  $variables['attributes']['class'][] = 'odesign-gestionnaire';

  // CSS inline critique en <head> — masque la toolbar avant le premier paint.
  $variables['page']['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag'  => 'style',
      '#value' => '#toolbar-administration,.toolbar-bar,.gin-secondary-toolbar{display:none!important}'
        . 'body.odesign-gestionnaire{margin-top:0!important;padding-top:44px!important}',
      '#attributes' => ['id' => 'odesign-gestionnaire-toolbar-hide'],
    ],
    'odesign_gestionnaire_toolbar_hide',
  ];
}

/**
 * Implémente hook_page_top().
 *
 * Injecte la barre de navigation boutique via le template Twig odesign_admin_nav.
 * Les items sont collectés via hook_odesign_boutique_nav_items_alter() (D-03 déclaratif).
 */
function odesign_admin_page_top(array &$page_top): void {
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  /** @var \Drupal\odesign_admin\Service\BoutiqueNavRegistry $registry */
  $registry = \Drupal::service('odesign_admin.boutique_nav_registry');
  $account  = \Drupal::currentUser();

  $page_top['odesign_admin_nav'] = [
    '#theme'      => 'odesign_admin_nav',
    '#nav_items'  => $registry->getNavItems(),
    '#site_url'   => Url::fromRoute('<front>')->toString(),
    '#username'   => $account->getDisplayName(),
    '#logout_url' => Url::fromRoute('user.logout')->toString(),
    '#weight'     => -100,
    '#cache'      => [
      'contexts' => ['route', 'user.roles'],
      'tags'     => ['commerce_order_list'],
    ],
  ];
}

/**
 * Implémente hook_theme().
 */
function odesign_admin_theme(): array {
  return [
    'odesign_admin_nav' => [
      'template'  => 'odesign-admin-nav',
      'variables' => [
        'nav_items'  => [],
        'site_url'   => '',
        'username'   => '',
        'logout_url' => '',
      ],
    ],
    'odesign_admin_dashboard' => [
      'template'  => 'odesign-admin-dashboard',
      'variables' => [
        'cards'           => [],
        'alert_messages'  => [],
        'orders_url'      => '',
        'orders_view'     => NULL,
        'recent_articles' => [],
        'top_products'    => [],
      ],
    ],
    'odesign_admin_clients' => [
      'template'  => 'odesign-admin-clients',
      'variables' => [
        'clients' => [],
      ],
    ],
    'odesign_admin_documentation' => [
      'template'  => 'odesign-admin-documentation',
      'variables' => [
        'chapters' => [],
        'content'  => NULL,
        'current'  => NULL,
      ],
    ],
    'campagne_en_cours_widget' => [
      'template'  => 'campagne-en-cours-widget',
      'variables' => [
        'node'      => NULL,
        'title'     => '',
        'hero'      => [],
        'cta_label' => '',
        'cta_url'   => '',
      ],
    ],
  ];
}

