/**
 * Personnalise le formulaire guide (création et édition).
 *
 * Masque les éléments techniques, améliore les libellés, adopte le workflow
 * éditorial (Brouillon → En relecture → Publié).
 */
function _odesign_admin_alter_guide_form(array &$form): void {
  // Masquer le sélecteur de format de texte via #after_build (même pattern qu'article).
  if (isset($form['body']['widget'][0])) {
    $form['body']['widget'][0]['#after_build'][] = '_odesign_admin_article_body_after_build';
  }

  // Masquer le journal de révision.
  foreach (['revision_log', 'revision_log_message', 'revision_information'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  // Libellés boutons : adapté au contexte guide.
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Enregistrer le guide');
  }
  if (isset($form['actions']['publish'])) {
    $form['actions']['publish']['#value'] = t('Enregistrer et publier');
  }
  if (isset($form['actions']['unpublish'])) {
    $form['actions']['unpublish']['#value'] = t('Enregistrer comme brouillon');
  }

  // Textes d'aide contextuels.
  if (isset($form['title'])) {
    $form['title']['widget'][0]['value']['#description'] =
      t('Le titre du guide marketing, tel qu\'il apparaîtra sur la page.');
  }
  if (isset($form['body'])) {
    if (isset($form['body']['widget'][0]['value'])) {
      $form['body']['widget'][0]['value']['#description'] =
        t('Contenu du guide. Utilisez la barre d\'outils pour structurer le texte, ajouter des images ou des liens.');
    }
  }

  // Améliorer le libellé du champ workflow (content_moderation) si présent.
  if (isset($form['moderation_state'])) {
    $form['moderation_state']['widget'][0]['state']['#title'] = t('Statut de publication');
    $form['moderation_state']['widget'][0]['state']['#description'] =
      t('Brouillon : travail en cours. En relecture : à valider. Publié : visible sur le site.');
  }

  // Lot 7 : section "Publication programmée" (scheduler).
  _odesign_admin_alter_scheduler_fields($form, 'guide');
}

/**
 * Améliore les champs scheduler dans un formulaire de nœud.
 *
 * Utilise #after_build pour garantir que la traduction du groupe scheduler
 * s'applique APRÈS tous les form_alters (scheduler crée son groupe en
 * hook_form_alter, notre hook_form_FORM_ID_alter peut tourner en parallèle).
 *
 * @param array $form
 *   Le formulaire à modifier.
 * @param string $entity_type_label
 *   Libellé du type de contenu pour les messages contextuels.
 */
function _odesign_admin_alter_scheduler_fields(array &$form, string $entity_type_label): void {
  // Traduire les libellés des champs directement (accessibles à la racine du form).
  if (isset($form['publish_on']['widget'][0]['value']['#title'])) {
    $form['publish_on']['widget'][0]['value']['#title'] = t('Publier automatiquement le');
    $form['publish_on']['widget'][0]['value']['#description'] =
      t('Date et heure auxquelles ce @type sera automatiquement publié. Laissez vide pour publier manuellement.', ['@type' => $entity_type_label]);
  }

  if (isset($form['unpublish_on']['widget'][0]['value']['#title'])) {
    $form['unpublish_on']['widget'][0]['value']['#title'] = t('Dépublier automatiquement le');
    $form['unpublish_on']['widget'][0]['value']['#description'] =
      t('Date et heure auxquelles ce @type sera automatiquement retiré du site. Laissez vide pour conserver la publication indéfiniment.', ['@type' => $entity_type_label]);
  }

  // Renommer le groupe scheduler via #after_build (scheduler peut tourner après
  // notre hook si les poids modules sont égaux → after_build est garanti dernier).
  $form['#after_build'][] = '_odesign_admin_scheduler_after_build';
}

/**
 * Callback #after_build : renomme le groupe "Scheduling options" → "Programmation".
 */
function _odesign_admin_scheduler_after_build(array $form, \Drupal\Core\Form\FormStateInterface $form_state): array {
  foreach (['scheduler_settings', 'scheduler_settings_2', 'scheduler_settings_3'] as $key) {
    if (isset($form[$key]['#title'])) {
      $form[$key]['#title'] = t('Programmation');
    }
  }
  return $form;
}

/**
 * Implements hook_form_FORM_ID_alter() for contact_message_atelier_contact_form.
 *
 * Ajoute un champ honeypot anti-spam (hidden via CSS, jamais visible humain).
 */
function odesign_admin_form_contact_message_atelier_contact_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['website'] = [
    '#type'       => 'textfield',
    '#title'      => t('Site web (ne pas remplir)'),
    '#attributes' => [
      'autocomplete' => 'off',
      'tabindex'     => '-1',
      'style'        => 'position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;',
      'aria-hidden'  => 'true',
    ],
    '#weight'     => -1000,
  ];
  $form['#validate'][] = 'odesign_admin_contact_honeypot_validate';
}

/**
 * Validateur honeypot — rejette silencieusement si le champ est rempli (bot).
 */
function odesign_admin_contact_honeypot_validate(array $form, FormStateInterface &$form_state): void {
  if (!empty($form_state->getValue('website'))) {
    \Drupal::logger('odesign_admin')->notice('Honeypot déclenché — soumission de formulaire contact bloquée.');
    $form_state->setErrorByName('', t('Une erreur de validation est survenue. Veuillez réessayer.'));
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * RGPD — Désactive GA4 si le visiteur n'a pas consenti aux cookies.
 * eu_cookie_compliance stocke le consentement dans le cookie 'cookie-agreed' :
 *   2 = accepté, 0/absent = refusé ou non encore choisi.
 *
 * Injecte également drupalSettings.ga4Order sur la page /merci pour permettre
 * le push de l'événement GA4 'purchase' côté client.
 */
function odesign_admin_page_attachments_alter(array &$attachments): void {
  // --- Bloc RGPD : retrait GA4 si consentement absent -----------------------
  $consent = \Drupal::request()->cookies->get('cookie-agreed', '0');
  if ($consent !== '2') {
    // Supprimer les librairies google_tag ajoutées par google_tag_page_attachments().
    if (!empty($attachments['#attached']['library'])) {
      $attachments['#attached']['library'] = array_values(array_filter(
        $attachments['#attached']['library'],
        static fn($lib) => !str_starts_with((string) $lib, 'google_tag/')
      ));
    }
    // Supprimer les drupalSettings gtag/gtm.
    unset(
      $attachments['#attached']['drupalSettings']['gtag'],
      $attachments['#attached']['drupalSettings']['gtm']
    );
  }
  // Varier le cache selon la valeur du cookie de consentement.
  $attachments['#cache']['contexts'][] = 'cookies:cookie-agreed';

  // --- Bloc GA4 purchase : injection ga4Order sur /merci --------------------
  if ($consent !== '2') {
    return;
  }
  $alias_manager = \Drupal::service('path_alias.manager');
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = $alias_manager->getAliasByPath($current_path);

  $is_merci = ($alias === '/merci');
  $is_checkout_complete = str_starts_with(\Drupal::routeMatch()->getRouteName() ?? '', 'commerce_checkout.');

  if (!$is_merci && !$is_checkout_complete) {
    return;
  }

  // Récupérer la dernière commande complétée de l'utilisateur courant.
  $current_user = \Drupal::currentUser();
  $order_storage = \Drupal::entityTypeManager()->getStorage('commerce_order');

  $query = $order_storage->getQuery()
    ->condition('state', ['fulfillment', 'completed', 'in_fabrication', 'quality_control', 'packed', 'shipped', 'delivered'], 'IN')
    ->accessCheck(FALSE)
    ->sort('order_id', 'DESC')
    ->range(0, 1);

  if ($current_user->isAuthenticated()) {
    $query->condition('uid', $current_user->id());
  }
  else {
    // Utilisateur anonyme : chercher via la session Commerce.
    /** @var \Drupal\commerce_cart\CartSessionInterface $cart_session */
    $cart_session = \Drupal::service('commerce_cart.cart_session');
    $order_ids = $cart_session->getCartIds();
    if (empty($order_ids)) {
      return;
    }
    $query->condition('order_id', $order_ids, 'IN');
  }

  $order_ids = $query->execute();
  if (empty($order_ids)) {
    return;
  }

  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $order_storage->load(reset($order_ids));
  if (!$order) {
    return;
  }

  $items = [];
  foreach ($order->getItems() as $order_item) {
    $items[] = [
      'item_name'  => $order_item->getTitle(),
      'item_id'    => $order_item->getPurchasedEntityId(),
      'price'      => (float) $order_item->getUnitPrice()->getNumber(),
      'quantity'   => (int) $order_item->getQuantity(),
    ];
  }

  $attachments['#attached']['drupalSettings']['ga4Order'] = [
    'id'    => $order->getOrderNumber() ?? $order->id(),
    'total' => (float) $order->getTotalPrice()->getNumber(),
    'items' => $items,
  ];
  $attachments['#cache']['max-age'] = 0;
}

/**
 * Implements hook_node_access().
 *
 * Restreint la consultation des nodes de type `guide` aux seuls rôles
 * `administrator` et `gestionnaire_boutique`. Les visiteurs anonymes et
 * les clients connectés n'ont pas accès à ces contenus stratégiques.
 */
function odesign_admin_node_access(\Drupal\node\NodeInterface $node, string $op, \Drupal\Core\Session\AccountInterface $account): \Drupal\Core\Access\AccessResultInterface {
  if ($node->bundle() === 'guide' && $op === 'view') {
    if ($account->hasRole('administrator') || $account->hasRole('gestionnaire_boutique')) {
      return \Drupal\Core\Access\AccessResult::neutral()->addCacheContexts(['user.roles']);
    }
    return \Drupal\Core\Access\AccessResult::forbidden()->addCacheContexts(['user.roles']);
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}
