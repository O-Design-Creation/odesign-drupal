/**
 * Implémente hook_odesign_boutique_dashboard_cards_alter().
 *
 * Déclare les tuiles de statistiques : produits, articles, newsletter, CA, commandes.
 */
function odesign_admin_odesign_boutique_dashboard_cards_alter(array &$cards): void {
  $db = \Drupal::database();

  try {
    $total_products = (int) \Drupal::entityQuery('commerce_product')
      ->condition('status', 1)
      ->accessCheck(FALSE)
      ->count()
      ->execute();
  }
  catch (\Exception) {
    $total_products = 0;
  }

  $cards['produits'] = [
    'title'     => 'Produits en ligne',
    'value'     => $total_products,
    'url'       => Url::fromRoute('entity.commerce_product.collection')->toString(),
    'icon'      => 'ph-package',
    'highlight' => FALSE,
    'weight'    => 20,
  ];

  // CA du mois courant (commandes complétées).
  try {
    $month_start = mktime(0, 0, 0, (int) date('n'), 1);
    $ca_raw = (float) $db->query(
      'SELECT COALESCE(SUM(total_price__number), 0) FROM {commerce_order}
       WHERE state = :state AND placed >= :start',
      [':state' => 'completed', ':start' => $month_start]
    )->fetchField();
    $ca_display = number_format($ca_raw, 0, ',', ' ') . ' €';
  }
  catch (\Exception) {
    $ca_display = '— €';
  }

  $cards['ca_mois'] = [
    'title'     => 'CA ce mois',
    'value'     => $ca_display,
    'url'       => Url::fromRoute('entity.commerce_order.collection')->toString(),
    'icon'      => 'ph-currency-eur',
    'highlight' => $ca_raw > 0,
    'weight'    => 25,
  ];


  try {
    $total_articles = (int) \Drupal::entityQuery('node')
      ->condition('type', 'article')
      ->condition('status', 1)
      ->accessCheck(FALSE)
      ->count()
      ->execute();
  }
  catch (\Exception) {
    $total_articles = 0;
  }

  $cards['articles'] = [
    'title'     => 'Articles publiés',
    'value'     => $total_articles,
    'url'       => Url::fromRoute('system.admin_content', [], ['query' => ['type' => 'article']])->toString(),
    'icon'      => 'ph-article',
    'highlight' => FALSE,
    'weight'    => 30,
  ];

  // Card newsletter : nombre d'abonnés confirmés.
  try {
    $total_subscribers = (int) \Drupal::entityQuery('simplenews_subscriber')
      ->condition('status', 1)
      ->accessCheck(FALSE)
      ->count()
      ->execute();
    $newsletter_url = Url::fromRoute('odesign_admin.newsletter')->toString();
  }
  catch (\Exception) {
    $total_subscribers = 0;
    $newsletter_url = '/admin/boutique';
  }

  $cards['newsletter'] = [
    'title'     => 'Abonnés newsletter',
    'value'     => $total_subscribers,
    'url'       => $newsletter_url,
    'icon'      => 'ph-envelope-simple',
    'highlight' => FALSE,
    'weight'    => 35,
  ];

}

/**
 * Implémente hook_mail().
 *
 * Définit l'email de test depuis la page de configuration boutique.
 */
function odesign_admin_mail(string $key, array &$message, array $params): void {
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';

  // ── Email de test (page configuration boutique) ───────────────────────────
  if ($key === 'test_email') {
    $message['subject'] = 'Test email — O\'Design Création';
    $message['body'][] = '<table style="max-width:500px;margin:30px auto;font-family:Georgia,serif;color:#3d2b1f;border:1px solid #e0dbd4;border-radius:4px;">'
      . '<tr><td style="text-align:center;padding:24px 0;border-bottom:1px solid #e4ddd5;background:#fdfaf7;">'
      . '<span style="font-size:20px;letter-spacing:.08em;text-transform:uppercase;">O\'Design Création</span></td></tr>'
      . '<tr><td style="padding:28px 24px;">'
      . '<p style="font-size:18px;margin:0 0 12px;">✅ Configuration email fonctionnelle</p>'
      . '<p style="color:#6b5744;margin:0;">Si vous recevez cet email, votre configuration Brevo fonctionne correctement. Vos clients recevront bien leurs confirmations de commande.</p>'
      . '</td></tr>'
      . '<tr><td style="text-align:center;padding:16px;font-size:11px;color:#b0a090;border-top:1px solid #e4ddd5;">'
      . 'O\'Design Création · <a href="https://atelierodesign.fr" style="color:#b0a090;">atelierodesign.fr</a></td></tr>'
      . '</table>';
    return;
  }
}

/**
 * Implémente hook_user_login().
 *
 * Redirige après connexion selon le rôle :
 * - gestionnaire_boutique → tableau de bord /admin/boutique
 * - client (authentifié sans rôle spécial) → /user/{uid}/orders
 */
function odesign_admin_user_login($account): void {
  $request = \Drupal::service('request_stack')->getCurrentRequest();
  if ($request->query->get('destination')) {
    // Une destination explicite est déjà définie — on ne l'écrase pas.
    return;
  }

  if ($account->hasRole('gestionnaire_boutique') && !$account->hasRole('administrator')) {
    $request->query->set('destination', '/admin/boutique');
  }
  elseif (!$account->hasRole('administrator') && !$account->hasRole('gestionnaire_boutique')) {
    // Client lambda : redirige vers ses commandes.
    $request->query->set('destination', '/user/' . $account->id() . '/orders');
  }
}

/**
 * Implémente hook_preprocess_page_title().
 *
 * Corrige le titre "Créer Article" → "Créer un article"
 * sur les formulaires de création/édition d'articles de blog.
 */
function odesign_admin_preprocess_page_title(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name === 'node.add') {
    $node_type = \Drupal::routeMatch()->getParameter('node_type');
    if ($node_type && (is_string($node_type) ? $node_type : $node_type->id()) === 'article') {
      $variables['title'] = t('Créer un article');
    }
  }
  elseif ($route_name === 'entity.node.edit_form') {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node && $node->getType() === 'article') {
      $variables['title'] = t('Modifier : @title', ['@title' => $node->getTitle()]);
    }
  }
}

/**
 * Implémente hook_form_FORM_ID_alter() pour le formulaire de produit.
 *
 * Ajoute des textes d'aide explicites sur chaque champ clé.
 */
function odesign_admin_form_commerce_product_default_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _odesign_admin_add_product_field_help($form);
}

/**
 * Implémente hook_form_FORM_ID_alter() pour la création de produit.
 */
function odesign_admin_form_commerce_product_default_add_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _odesign_admin_add_product_field_help($form);
}

/**
 * Ajoute les descriptions d'aide sur le formulaire produit.
 */
function _odesign_admin_add_product_field_help(array &$form): void {
  // Titre du produit.
  if (isset($form['title'])) {
    $form['title']['widget'][0]['value']['#description'] =
      t('Le nom exact de votre création, tel qu\'il apparaîtra sur le site. Soyez précis et descriptif (ex. : "Prénom en bois - chêne naturel").');
  }

  // Statut publié/brouillon.
  if (isset($form['status'])) {
    $form['status']['widget']['value']['#description'] =
      t('Activé : le produit est visible sur votre boutique. Désactivé : brouillon, invisible pour les clients.');
  }

  // Description / Corps.
  if (isset($form['body'])) {
    if (isset($form['body']['widget'][0])) {
      $form['body']['widget'][0]['odesign_help'] = [
        '#type' => 'markup',
        '#markup' => '<div class="form-item__description">'
          . t('Description détaillée du produit : matières, dimensions, personnalisation possible, conseils d\'entretien…')
          . '</div>',
        '#weight' => -100,
      ];
    }
    if (isset($form['body']['widget'][0]['value'])) {
      $form['body']['widget'][0]['value']['#description'] =
        t('Décrivez clairement le produit, ses matières, ses dimensions et ses options de personnalisation.');
      if (!empty($form['body']['widget'][0]['value']['#disabled'])) {
        $form['body']['widget'][0]['value']['#attributes']['class'][] = 'odesign-readonly-longtext';
      }
    }
    if (isset($form['body']['widget'][0]['summary'])) {
      $form['body']['widget'][0]['summary']['#description'] =
        t('Optionnel : un résumé court utilisé sur certaines listes ou aperçus.');
    }
  }

  // Boutique associée.
  if (isset($form['stores'])) {
    $form['stores']['widget']['#description'] =
      t('Laissez "ODesign" sélectionné — c\'est votre boutique.');
  }

  // Variantes / prix.
  if (isset($form['variations'])) {
    $form['variations']['#description'] =
      t('Définissez le prix de vente TTC de votre produit. Si votre produit existe en plusieurs options (taille, couleur…), créez une variante par option.');
  }

  // Format de texte — sélecteur CKEditor : masquer pour le gestionnaire (UX-03).
  // Le gestionnaire dispose déjà du format "full_html" par défaut.
  // Le sélecteur de format est un détail technique sans valeur métier.
  if (isset($form['body']['widget'][0]['format'])) {
    $form['body']['widget'][0]['format']['#access'] = FALSE;
  }
  // Catégorie produit.
  if (isset($form['field_category'])) {
    $form['field_category']['widget']['#description'] =
      t('Associez une catégorie à ce produit pour faciliter sa recherche dans la boutique. Commencez à saisir pour voir les catégories existantes ou créez-en une nouvelle.');
    // Aide supplémentaire visible directement dans le form item.
    if (isset($form['field_category']['widget']['target_id'])) {
      $form['field_category']['widget']['target_id']['#description'] =
        t('Catégorie de ce produit (ex. : "Prénom en bois", "Bijoux"). Commencez à saisir ou créez-en une nouvelle.');
    }
  }

  // Images produit.
  if (isset($form['field_product_images'])) {
    $form['field_product_images']['widget']['#description'] =
      t('Ajoutez une ou plusieurs photos de votre produit. Conseil : utilisez des photos carrées, fond neutre, bonne luminosité. La première image sera affichée en priorité.');
    $form['field_product_images']['#weight'] = -10;
  }
}

/**
 * Implémente hook_form_alter() pour personnaliser les labels de l'interface.
 */
function odesign_admin_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {

  // --- SSO Google : bouton sur login et register ----------------------------
  if (in_array($form_id, ['user_login_form', 'user_register_form'])) {
    if (\Drupal::moduleHandler()->moduleExists('social_auth_google')) {
      // Vérifier que le module est configuré (Client ID non vide).
      $google_config = \Drupal::config('social_auth_google.settings');
      $client_id = $google_config->get('client_id');
      if (!empty($client_id)) {
        $form['social_auth'] = [
          '#type'       => 'container',
          '#weight'     => -10,
          '#attributes' => ['class' => ['social-auth-buttons']],
          'google'      => [
            '#type'       => 'link',
            '#title'      => t('Continuer avec Google'),
            '#url'        => \Drupal\Core\Url::fromRoute('social_auth.network.redirect', ['network' => 'google']),
            '#attributes' => ['class' => ['btn', 'btn-social', 'btn-google']],
          ],
        ];
        $form['social_auth_divider'] = [
          '#type'       => 'container',
          '#weight'     => -9,
          '#attributes' => ['class' => ['social-auth-divider']],
          'text'        => [
            '#markup' => t('ou'),
          ],
        ];
        $form['#attached']['library'][] = 'odesign_base/social-auth';
      }
    }
  }
  // -------------------------------------------------------------------------

  // Améliorer le libellé du bouton "Enregistrer" sur les formulaires produit.
  if (in_array($form_id, [
    'commerce_product_default_add_form',
    'commerce_product_default_edit_form',
  ])) {
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Enregistrer le produit');
    }
    foreach ($form['actions'] as &$action) {
      if (!is_array($action)) {
        continue;
      }
      if (($action['#id'] ?? '') === 'edit-actions-submit-continue'
        || ($action['#value'] ?? '') === 'Save and add variations') {
        $action['#value'] = t('Enregistrer puis ajouter des variantes');
      }
    }
    unset($action);
    if (isset($form['actions']['delete'])) {
      $form['actions']['delete']['#value'] = t('Supprimer ce produit');
    }
  }

  // Ajouter des aides sur le formulaire ajout/édition de média image produit.
  if (in_array($form_id, ['media_product_image_add_form', 'media_product_image_edit_form'])) {
    if (isset($form['name'])) {
      $form['name']['widget'][0]['value']['#description'] =
        t('Nom interne pour retrouver cette image (ex. : "Photo principale - Prénom Léa"). Non visible sur le site.');
    }
    if (isset($form['field_media_image'])) {
      $form['field_media_image']['widget']['#description'] =
        t('Ajoutez votre photo principale au format JPG, PNG ou WebP. Préférez une image nette, lumineuse et centrée sur la création.');
    }
    if (isset($form['status'])) {
      $form['status']['widget']['value']['#description'] =
        t('Activé : l\'image est disponible pour être utilisée sur vos produits.');
    }
    // Masquer les champs techniques inutiles pour le gestionnaire.
    foreach (['advanced', 'author', 'uid', 'created', 'revision_log_message'] as $technical_key) {
      if (isset($form[$technical_key])) {
        $form[$technical_key]['#access'] = FALSE;
      }
    }
  }

  // Formulaire d'abonnement newsletter : une seule liste → champ de sélection superflu.
  if (str_starts_with($form_id, 'simplenews_subscriptions_block_')) {
    // Masquer le sélecteur de listes (superflu avec une seule newsletter).
    if (isset($form['subscriptions'])) {
      $form['subscriptions']['#access'] = FALSE;
    }
    // Masquer le lien "Manage existing subscriptions" (dans actions, pas footer).
    if (isset($form['actions']['manage'])) {
      $form['actions']['manage']['#access'] = FALSE;
    }
    // Traduire le bouton "Subscribe" en français.
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t("S'inscrire");
    }
    // Masquer le lien "Manage existing subscriptions" (inutile dans le bandeau).
    if (isset($form['footer'])) {
      $form['footer']['#access'] = FALSE;
    }
    // Masquer le message de description de la newsletter (en anglais, inutile).
    if (isset($form['message'])) {
      $form['message']['#access'] = FALSE;
    }
    // Masquer la description du champ email ("The subscriber's email address.").
    if (isset($form['mail'])) {
      $form['mail']['widget'][0]['value']['#description'] = '';
      $form['mail']['widget'][0]['value']['#placeholder'] = t('Votre adresse e-mail');
    }
    // Placeholder de secours sur tous les champs email du formulaire.
    array_walk_recursive($form, function (&$item) {
      if (is_array($item) && ($item['#type'] ?? '') === 'email') {
        $item['#description'] = '';
        if (empty($item['#placeholder'])) {
          $item['#placeholder'] = t('Votre adresse e-mail');
        }
      }
    });
    $form['gdpr_consent'] = [
      '#type'          => 'checkbox',
      '#title'         => t("J'accepte de recevoir la newsletter de O\'Design Création et je comprends que je peux me désabonner à tout moment. <a href=\"/politique-confidentialite\" target=\"_blank\">Politique de confidentialité</a>."),
      '#required'      => TRUE,
      '#weight'        => 5,
      '#attributes'    => ['class' => ['newsletter-gdpr-checkbox']],
    ];
  }

  // Ajouter des aides sur le formulaire promotion.
  if (str_starts_with($form_id, 'commerce_promotion_')) {
    if (isset($form['name'])) {
      $form['name']['widget'][0]['value']['#description'] =
        t('Nom interne de la promotion (ex. : "Soldes été 2026"). Non visible sur le site.');
    }
    if (isset($form['offer'])) {
      $form['offer']['widget'][0]['target_plugin_id']['#description'] =
        t('Choisissez le type de remise : pourcentage sur le total, montant fixe, etc.');
    }
  }
}

/**
 * Implémente hook_form_FORM_ID_alter() pour la page des variantes produit.
 */
function odesign_admin_form_commerce_product_variations_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Enregistrer l’ordre des variantes');
  }

  if (!isset($form['variations']) || !is_array($form['variations'])) {
    return;
  }

  $variation_rows = &$form['variations'];
  foreach (Element::children($variation_rows) as $variation_id) {
    if (!isset($form['variations'][$variation_id]['weight'])) {
      continue;
    }

    $form['variations'][$variation_id]['weight']['#description'] = t('Utilisez ce poids pour changer l’ordre d’affichage des variantes sur la page produit. 0 = position actuelle, un nombre plus petit remonte plus haut.');
  }
}

/**
 * Implémente hook_menu_links_discovered_alter().
 *
 * Renomme les sections de navigation admin en termes métier français.
 */
function odesign_admin_menu_links_discovered_alter(array &$links): void {
  // "Commerce" → "Ma boutique"
  if (isset($links['commerce.admin_commerce'])) {
    $links['commerce.admin_commerce']['title'] = 'Ma boutique';
  }
  // "Produits" → "Mes produits"
  if (isset($links['commerce_product.admin'])) {
    $links['commerce_product.admin']['title'] = 'Mes produits';
  }
  // Raccourci vers le dashboard boutique
  $links['odesign_admin.dashboard_shortcut'] = [
    'title'       => 'Tableau de bord',
    'route_name'  => 'odesign_admin.dashboard',
    'menu_name'   => 'admin',
    'parent'      => '',
    'weight'      => -100,
    'description' => 'Retour au tableau de bord de la boutique',
    'provider'    => 'odesign_admin',
    'class'       => 'Drupal\\Core\\Menu\\MenuLinkDefault',
    'metadata'    => ['expanded' => FALSE],
  ];
}

/**
 * Callback #after_build pour masquer le sélecteur de format de texte.
 *
 * Le widget text_format construit l'élément 'format' via ses callbacks #process,
 * lesquels s'exécutent après form_alter. On utilise #after_build (post-process)
 * pour garantir que la suppression s'applique correctement.
 *
 * Appliqué sur le corps des articles et des descriptions d'univers.
 */
function _odesign_admin_article_body_after_build(array $element): array {
  if (isset($element['format'])) {
    $element['format']['#access'] = FALSE;
  }
  return $element;
}

/**
 * Implémente hook_mail_alter().
 *
 * Personnalise les emails Commerce envoyés au gestionnaire et au client.
 */
function odesign_admin_mail_alter(array &$message): void {
  // S'assurer que les emails Commerce sont bien en français.
  if (str_starts_with($message['id'] ?? '', 'commerce_')) {
    $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
  }
}

/**
 * Implémente hook_form_FORM_ID_alter() pour le formulaire d'article.
 *
 * Masque les champs techniques non pertinents pour la gestionnaire (UX-03)
 * et ajoute des textes d'aide sur les champs éditoriaux (UX-02).
 */
function odesign_admin_form_node_article_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _odesign_admin_alter_article_form($form);
}

/**
 * Implémente hook_form_FORM_ID_alter() pour l'édition d'article.
 */
function odesign_admin_form_node_article_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  _odesign_admin_alter_article_form($form);
}

/**
 * Personnalise le formulaire article (création et édition).
 */
function _odesign_admin_alter_article_form(array &$form): void {
  // UX-03 : masquer le sélecteur de format de texte et le journal de révision.
  // Note : l'élément 'format' est construit par les callbacks #process du widget
  // text_format après l'exécution de form_alter → on utilise #after_build.
  if (isset($form['body']['widget'][0])) {
    $form['body']['widget'][0]['#after_build'][] = '_odesign_admin_article_body_after_build';
  }

  // UX-03 : masquer le journal de révision — détail technique sans valeur métier.
  foreach (['revision_log', 'revision_log_message', 'revision_information'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  // UX-01 : améliorer le libellé du bouton de sauvegarde.
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Enregistrer l\'article');
  }
  if (isset($form['actions']['publish'])) {
    $form['actions']['publish']['#value'] = t('Enregistrer et publier');
  }
  if (isset($form['actions']['unpublish'])) {
    $form['actions']['unpublish']['#value'] = t('Enregistrer comme brouillon');
  }

  // UX-02 : textes d'aide sur les champs clés.
  if (isset($form['title'])) {
    $form['title']['widget'][0]['value']['#description'] =
      t('Le titre de votre article, tel qu\'il apparaîtra sur le blog.');
  }
  if (isset($form['body'])) {
    if (isset($form['body']['widget'][0]['value'])) {
      $form['body']['widget'][0]['value']['#description'] =
        t('Le contenu principal de votre article. Utilisez la barre d\'outils pour mettre en forme le texte, ajouter des images ou des liens.');
    }
  }
  if (isset($form['field_image'])) {
    $form['field_image']['widget']['#description'] =
      t('Photo principale de l\'article, affichée en tête de page et dans la liste du blog. Préférez une image horizontale, nette et en lien avec le sujet.');
  }
  if (isset($form['field_blog_category'])) {
    $form['field_blog_category']['widget']['#description'] =
      t('Catégorie thématique de l\'article (ex. : "Inspiration", "Conseils", "Nouveautés"). Saisir pour voir ou créer une catégorie.');
  }
  if (isset($form['status'])) {
    $form['status']['widget']['value']['#description'] =
      t('Coché : l\'article est visible sur le blog. Décoché : brouillon, invisible pour les visiteurs.');
  }

  // Lot 7 : section "Publication programmée" (scheduler).
  _odesign_admin_alter_scheduler_fields($form, 'article');
}

/**
 * Implémente hook_form_taxonomy_term_form_alter().
 *
 * Masque les champs techniques du formulaire d'édition des univers (UX-03)
 * et clarifie les libellés techniques (UX-01).
 * Ajoute un lien "Voir sur le site" vers la page de l'univers (Lot 6).
 */
function odesign_admin_form_taxonomy_term_life_occasion_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // UX-03 : masquer les blocs de gestion des révisions et des métadonnées système.
  foreach (['revision_log_message', 'revision_information', 'revision'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  // UX-03 : masquer les champs techniques dans la section "relations".
  if (isset($form['relations']['#type']) && $form['relations']['#type'] === 'details') {
    $form['relations']['#title'] = t('Organisation (terme parent)');
    $form['relations']['#description'] = t('Si cet univers appartient à une catégorie parente, sélectionnez-la ici. Laissez vide pour un univers de premier niveau.');
  }

  // UX-01 : améliorer le libellé du bouton de sauvegarde.
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Enregistrer l\'univers');
  }

  // UX-02 : textes d'aide sur les champs éditoriaux de l'univers.
  if (isset($form['name'])) {
    $form['name']['widget'][0]['value']['#description'] =
      t('Le nom de l\'univers, tel qu\'il apparaît sur le site (ex. : "Mariage", "Naissance").');
  }
  if (isset($form['description'])) {
    if (isset($form['description']['widget'][0]['value'])) {
      $form['description']['widget'][0]['value']['#description'] =
        t('Texte d\'introduction affiché sur la page de cet univers. Décrivez les occasions concernées et les créations proposées.');
    }
    // Masquer le sélecteur de format de texte via #after_build.
    if (isset($form['description']['widget'][0])) {
      $form['description']['widget'][0]['#after_build'][] = '_odesign_admin_article_body_after_build';
    }
  }

  // Lot 6 : titre contextuel + lien "Voir sur le site".
  /** @var \Drupal\taxonomy\TermInterface|null $term */
  $term = $form_state->getFormObject()->getEntity();
  if ($term && !$term->isNew()) {
    // Titre contextuel : "Modifier l'univers : Mariage"
    $form['#title'] = t('Modifier l\'univers : @name', ['@name' => $term->label()]);

    // Lien "Voir sur le site" dans la barre d'actions.
    $term_url = \Drupal\Core\Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $term->id()]);
    $form['actions']['view_on_site'] = [
      '#type'       => 'link',
      '#title'      => t('Voir sur le site'),
      '#url'        => $term_url,
      '#attributes' => [
        'class'  => ['button', 'button--secondary'],
        'target' => '_blank',
        'rel'    => 'noopener',
      ],
      '#prefix' => '<i class="ph ph-arrow-square-out" aria-hidden="true"></i> ',
      '#weight' => 10,
    ];
  }
}

/**
 * Implémente hook_odesign_boutique_config_sections_alter().
 *
 * Déclare les sections de configuration de la boutique (D-04) :
 * Mailgun, Stripe, Boutique, Hero, "Je me présente", Promotions volume.
 * D'autres modules peuvent ajouter leurs propres sections via ce hook.
