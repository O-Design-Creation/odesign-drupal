<?php

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_schema().
 */
function odesign_admin_schema(): array {
  $schema['odesign_search_no_result_log'] = [
    'description' => 'Journal des requêtes de recherche sans résultat (B2C).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'query_hash' => [
        'type' => 'varchar',
        'length' => 40,
        'not null' => TRUE,
      ],
      'query_raw' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'query_normalized' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'hit_count' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'last_result_count' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'first_seen' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'last_seen' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'query_hash' => ['query_hash'],
    ],
    'indexes' => [
      'last_seen' => ['last_seen'],
      'hit_count' => ['hit_count'],
    ],
  ];

  return $schema;
}

/**
 * Aligne les valeurs de suivi atelier avec le workflow artisanal.
 */
function odesign_admin_update_11001(): string {
  $storage = FieldStorageConfig::loadByName('commerce_order', 'field_atelier_status');
  if (!$storage) {
    return 'Champ field_atelier_status introuvable, aucune mise à jour appliquée.';
  }

  $storage->setSetting('allowed_values', [
    'a_verifier' => 'À valider',
    'validee_atelier' => 'Validée atelier',
    'en_production' => 'En fabrication',
    'controle_qualite' => 'Contrôle qualité',
    'emballee_prete' => 'Emballée / prête à expédier',
    'expediee' => 'Expédiée',
    'en_attente_client' => 'En attente client',
    'livraison_prevue' => 'Livraison prévue',
    'annulee' => 'Annulée',
    'remboursee' => 'Remboursée',
    'termine' => 'Terminée',
  ]);
  $storage->save();

  return 'Valeurs du suivi interne atelier mises à jour.';
}

/**
 * Installe le module métier commandes extrait de odesign_admin.
 */
function odesign_admin_update_11002(): string {
  $module_installer = \Drupal::service('module_installer');
  if (\Drupal::moduleHandler()->moduleExists('odesign_orders')) {
    return 'Le module odesign_orders est déjà activé.';
  }

  $module_installer->install(['odesign_orders']);
  return 'Module odesign_orders activé (refonte modulaire commandes).';
}

/**
 * Migre les secrets SMTP/Stripe vers state et nettoie la configuration.
 */
function odesign_admin_update_11003(): string {
  $state = \Drupal::state();

  $messages = [];

  $smtp = \Drupal::configFactory()->getEditable('smtp.settings');
  $smtp_password = (string) $smtp->get('smtp_password');
  if ($smtp_password !== '' && $state->get('odesign_admin.smtp_password', '') === '') {
    $state->set('odesign_admin.smtp_password', $smtp_password);
    $messages[] = 'smtp_password migré vers state.';
  }
  if ($smtp_password !== '') {
    $smtp->set('smtp_password', '')->save();
    $messages[] = 'smtp_password retiré de smtp.settings.';
  }

  $stripe = \Drupal::configFactory()->getEditable('commerce_payment.commerce_payment_gateway.stripe_sandbox');
  $configuration = $stripe->get('configuration') ?? [];
  $stripe_secret = trim((string) ($configuration['secret_key'] ?? ''));
  $stripe_webhook_secret = trim((string) ($configuration['webhook_secret'] ?? ''));

  if ($stripe_secret !== '' && $state->get('odesign_admin.stripe_sandbox.secret_key', '') === '') {
    $state->set('odesign_admin.stripe_sandbox.secret_key', $stripe_secret);
    $messages[] = 'Stripe secret_key migrée vers state.';
  }
  if ($stripe_webhook_secret !== '' && $state->get('odesign_admin.stripe_sandbox.webhook_secret', '') === '') {
    $state->set('odesign_admin.stripe_sandbox.webhook_secret', $stripe_webhook_secret);
    $messages[] = 'Stripe webhook_secret migrée vers state.';
  }

  $updated = FALSE;
  if (isset($configuration['secret_key'])) {
    unset($configuration['secret_key']);
    $updated = TRUE;
  }
  if (isset($configuration['webhook_secret'])) {
    unset($configuration['webhook_secret']);
    $updated = TRUE;
  }
  if ($updated) {
    $stripe->set('configuration', $configuration)->save();
    $messages[] = 'Secrets retirés de la config Stripe exportable.';
  }

  return $messages ? implode(' ', $messages) : 'Aucune migration de secret nécessaire.';
}

/**
 * Crée le journal des recherches sans résultat.
 */
function odesign_admin_update_11004(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('odesign_search_no_result_log')) {
    return 'Table odesign_search_no_result_log déjà présente.';
  }

  $definition = odesign_admin_schema()['odesign_search_no_result_log'];
  $schema->createTable('odesign_search_no_result_log', $definition);
  return 'Table odesign_search_no_result_log créée.';
}
