<?php

/**
 * Implémente hook_mail() pour les notifications commandes.
 */
function odesign_orders_mail(string $key, array &$message, array $params): void {
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';

  if ($key === 'new_order_notification') {
    $order = $params['order'] ?? NULL;
    $order_number = $params['order_number'] ?? ($order ? $order->getOrderNumber() : '—');
    $total = $params['total'] ?? '—';
    $message['subject'] = 'Nouvelle commande reçue — #' . $order_number;
    $message['body'][] = '<table style="max-width:600px;margin:30px auto;font-family:Georgia,serif;color:#3d2b1f;">'
      . '<tr><td style="text-align:center;padding:24px 0;border-bottom:1px solid #e4ddd5;"><span style="font-size:20px;letter-spacing:.08em;text-transform:uppercase;">Atelier O Design</span></td></tr>'
      . '<tr><td style="padding:28px 24px;">'
      . '<p style="font-size:18px;color:#3d2b1f;margin:0 0 16px;">Nouvelle commande à traiter</p>'
      . '<p style="margin:0 0 8px;"><strong>Commande</strong> : #' . htmlspecialchars((string) $order_number) . '</p>'
      . '<p style="margin:0 0 8px;"><strong>Total</strong> : ' . htmlspecialchars((string) $total) . '</p>'
      . '</td></tr>'
      . '<tr><td style="text-align:center;padding:16px;font-size:11px;color:#b0a090;border-top:1px solid #e4ddd5;">Atelier O Design</td></tr>'
      . '</table>';
    return;
  }

  $order = $params['order'] ?? NULL;
  $label = $params['label'] ?? '';
  $subject = $params['subject'] ?? $label;

  $message['subject'] = $subject;

  if (!$order) {
    return;
  }

  $order_number = $order->getOrderNumber();
  $total = $order->getTotalPrice()
    ? \Drupal::service('commerce_price.currency_formatter')->format(
      $order->getTotalPrice()->getNumber(),
      $order->getTotalPrice()->getCurrencyCode()
    )
    : '—';
  $customer = $order->getEmail();

  $body = '<table style="max-width:600px;margin:30px auto;font-family:Georgia,serif;color:#3d2b1f;">';
  $body .= '<tr><td style="text-align:center;padding:24px 0;border-bottom:1px solid #e4ddd5;">';
  $body .= '<span style="font-size:20px;letter-spacing:.08em;text-transform:uppercase;">Atelier O Design</span></td></tr>';
  $body .= '<tr><td style="padding:28px 24px;">';
  $body .= '<p style="font-size:18px;color:#3d2b1f;margin:0 0 16px;">' . htmlspecialchars($label) . '</p>';
  $body .= '<p style="margin:0 0 8px;"><strong>Commande</strong> : #' . htmlspecialchars($order_number ?? '—') . '</p>';
  $body .= '<p style="margin:0 0 8px;"><strong>Client</strong> : ' . htmlspecialchars($customer) . '</p>';
  $body .= '<p style="margin:0 0 24px;"><strong>Total</strong> : ' . htmlspecialchars($total) . '</p>';

  if (in_array($params['transition_id'] ?? '', ['ship', 'deliver'], TRUE)) {
    $order_url = \Drupal\Core\Url::fromRoute('commerce_order.order_user_view', [
      'user' => $order->getCustomerId(),
      'commerce_order' => $order->id(),
    ])->setAbsolute()->toString();
    $body .= '<p><a href="' . $order_url . '" style="display:inline-block;padding:10px 24px;background:#8b6f47;color:#fff;text-decoration:none;font-size:13px;border-radius:2px;">Voir ma commande</a></p>';
  }

  $body .= '</td></tr>';
  $body .= '<tr><td style="text-align:center;padding:16px;font-size:11px;color:#b0a090;border-top:1px solid #e4ddd5;">';
  $body .= 'Atelier O Design · <a href="https://atelierodesign.fr" style="color:#b0a090;">atelierodesign.fr</a></td></tr>';
  $body .= '</table>';

  $message['body'][] = $body;
}

/**
 * Implémente hook_theme_registry_alter() pour les emails commandes.
 */
function odesign_orders_theme_registry_alter(array &$theme_registry): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('odesign_orders');
  $email_path = $module_path . '/templates/email';
  if (isset($theme_registry['commerce_order_receipt'])) {
    $theme_registry['commerce_order_receipt']['path'] = $email_path;
    $theme_registry['commerce_order_receipt']['template'] = 'commerce-order-receipt';
  }
}

/**
 * Implémente hook_commerce_order_post_save().
 *
 * Envoie une notification interne lors d'une nouvelle commande en attente.
 */
function odesign_orders_commerce_order_post_save(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  if ($order->getState()->getId() !== 'pending') {
    return;
  }

  $manager_emails = [];
  $ids = \Drupal::entityQuery('user')
    ->condition('roles', 'gestionnaire_boutique')
    ->condition('status', 1)
    ->accessCheck(FALSE)
    ->execute();

  foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($ids) as $user) {
    $manager_emails[] = $user->getEmail();
  }

  $store = $order->getStore();
  if ($store) {
    $manager_emails[] = $store->getEmail();
  }

  $manager_emails = array_unique(array_filter($manager_emails));
  if (empty($manager_emails)) {
    return;
  }

  $order_number = $order->getOrderNumber();
  $total = $order->getTotalPrice();
  $total_formatted = \Drupal::service('commerce_price.currency_formatter')
    ->format($total->getNumber(), $total->getCurrencyCode());

  foreach ($manager_emails as $email) {
    \Drupal::service('plugin.manager.mail')->mail(
      'odesign_orders',
      'new_order_notification',
      $email,
      'fr',
      ['order' => $order, 'order_number' => $order_number, 'total' => $total_formatted],
    );
  }
}

/**
 * Implémente hook_form_FORM_ID_alter() pour la création de commande.
 */
function odesign_orders_form_commerce_order_add_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  _odesign_orders_clean_order_form($form);
}

/**
 * Implémente hook_form_FORM_ID_alter() pour l'édition de commande.
 */
function odesign_orders_form_commerce_order_default_edit_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  _odesign_orders_clean_order_form($form);
}

/**
 * Implémente hook_form_alter() pour les formulaires commande.
 */
function odesign_orders_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if (str_starts_with($form_id, 'commerce_order_') && isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Enregistrer la commande');
  }
}

/**
 * Corrige le libellé du bouton add-to-cart.
 */
function odesign_orders_form_commerce_order_item_add_to_cart_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Ajouter au panier');
  }
}

/**
 * Implémente hook_toolbar_alter() pour le raccourci commandes gestionnaire.
 */
function odesign_orders_toolbar_alter(array &$items): void {
  $account = \Drupal::currentUser();
  if (!$account->hasRole('gestionnaire_boutique')) {
    return;
  }

  if (isset($items['commerce_inbox'])) {
    $items['commerce_inbox']['tab']['#lazy_builder'] = [
      'odesign_orders.lazy_builders:renderOrdersInbox',
      [],
    ];
  }
}

/**
 * Masque les champs techniques et ajoute des descriptions métier commande.
 */
function _odesign_orders_clean_order_form(array &$form): void {
  if (isset($form['uid'])) {
    $form['uid']['#access'] = FALSE;
  }

  if (isset($form['customer_type'])) {
    $form['customer_type']['#description'] = t('Indiquez si ce client est déjà enregistré dans la boutique ou s\'il s\'agit d\'un nouvel acheteur.');
  }
  if (isset($form['custom_placed_date'])) {
    $form['custom_placed_date']['#description'] = t('Cochez cette case uniquement si vous souhaitez enregistrer la commande à une date différente d\'aujourd\'hui.');
  }
  if (isset($form['placed']) && isset($form['placed']['widget'][0]['value'])) {
    $form['placed']['widget'][0]['value']['#description'] = t('Date à laquelle la commande a été passée.');
  }
}

/**
 * Implémente hook_menu_links_discovered_alter() pour le libellé commandes.
 */
function odesign_orders_menu_links_discovered_alter(array &$links): void {
  if (isset($links['entity.commerce_order.collection'])) {
    $links['entity.commerce_order.collection']['title'] = 'Mes commandes';
  }
  if (isset($links['commerce_order.admin'])) {
    $links['commerce_order.admin']['title'] = 'Mes commandes';
  }
}
