<?php

/**
 * @file
 * odesign_base.theme — Fonctions du thème O'Design Création.
 */

use Drupal\image\Entity\ImageStyle;
use Drupal\Component\Utility\Unicode;
use Drupal\Component\Utility\Html;
use Drupal\Core\File\FileSystemInterface;
use Drupal\Core\Url;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_preprocess_html().
 *
 * - Injecte <meta name="robots" content="noindex,nofollow"> sur les pages
 *   transactionnelles (panier, checkout, compte utilisateur).
 * - Ajoute une body class pour les pages d'authentification (login/register/password)
 *   afin de permettre un ciblage CSS dédié.
 */
function odesign_base_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $noindex_routes = [
    'commerce_cart.page',
    'user.login',
    'user.register',
    'user.pass',
    'user.page',
    'entity.user.canonical',
    'entity.user.edit_form',
  ];
  $is_noindex = in_array($route, $noindex_routes, TRUE)
    || str_starts_with($route, 'commerce_checkout.');

  // Noindex également pour les aliases de confirmation (ex: /merci).
  if (!$is_noindex) {
    $current_path = \Drupal::service('path.current')->getPath();
    $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $noindex_aliases = ['/merci'];
    $is_noindex = in_array($alias, $noindex_aliases, TRUE);
  }

  if ($is_noindex) {
    $variables['page']['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'meta',
        '#attributes' => [
          'name'    => 'robots',
          'content' => 'noindex,nofollow',
        ],
      ],
      'odesign_noindex_transactional',
    ];
  }

  $auth_routes = ['user.login', 'user.register', 'user.pass'];
  if (in_array($route, $auth_routes, TRUE)) {
    $variables['attributes']['class'][] = 'page--user-auth';
    $variables['attributes']['class'][] = 'page--user-auth--' . str_replace('.', '-', $route);
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Supprime la favicon Drupal core et injecte le jeu complet de favicons
 * générés depuis le logo SVG.
 */
function odesign_base_page_attachments_alter(array &$attachments): void {
  $route_term = \Drupal::routeMatch()->getParameter('taxonomy_term');

  // Supprimer la favicon Drupal core
  if (isset($attachments['#attached']['html_head'])) {
    foreach ($attachments['#attached']['html_head'] as $key => $item) {
      if (isset($item[1]) && $item[1] === 'favicon') {
        unset($attachments['#attached']['html_head'][$key]);
      }

      if (
        $route_term instanceof TermInterface &&
        $route_term->bundle() === 'life_occasion' &&
        isset($attachments['#attached']['html_head'][$key][0]['#tag'], $attachments['#attached']['html_head'][$key][0]['#attributes']['type']) &&
        $attachments['#attached']['html_head'][$key][0]['#tag'] === 'link' &&
        $attachments['#attached']['html_head'][$key][0]['#attributes']['type'] === 'application/rss+xml' &&
        isset($attachments['#attached']['html_head'][$key][0]['#attributes']['title'])
      ) {
        $attachments['#attached']['html_head'][$key][0]['#attributes']['title'] = Html::decodeEntities((string) $attachments['#attached']['html_head'][$key][0]['#attributes']['title']);
      }
    }
  }
}

/**
 * Implements hook_preprocess_commerce_product().
 */
function odesign_base_preprocess_commerce_product(array &$variables): void {
  if (empty($variables['product_entity']) || !$variables['product_entity'] instanceof ProductInterface) {
    return;
  }
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $variables['product_entity'];

  $variables['product_back_to_catalog_url'] = Url::fromUri('internal:/produits')->toString();
  $variables['product_life_occasion_links'] = [];
  $variables['product_related_teasers'] = '';
  $variables['product_has_volume_offer'] = FALSE;
  $variables['product_volume_offer_label'] = '';
  $variables['product_volume_offer_tiers'] = [];
  $product_term_ids = [];

  if ($product->hasField('field_life_occasion') && !$product->get('field_life_occasion')->isEmpty()) {
    $terms = $product->get('field_life_occasion')->referencedEntities();
    foreach ($terms as $term) {
      if ($term instanceof TermInterface) {
        $product_term_ids[] = (int) $term->id();
        $variables['product_life_occasion_links'][] = [
          'title' => $term->label(),
          'url' => $term->toUrl()->toString(),
        ];
      }
    }

    /** @var \Drupal\taxonomy\TermInterface|null $primary_term */
    $primary_term = $terms[0] ?? NULL;
    if ($primary_term instanceof TermInterface) {
      $storage = \Drupal::entityTypeManager()->getStorage('commerce_product');
      $related_ids = $storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('status', 1)
        ->condition('field_life_occasion.target_id', $primary_term->id())
        ->condition('product_id', $product->id(), '<>')
        ->sort('changed', 'DESC')
        ->range(0, 4)
        ->execute();

      if ($related_ids) {
        $related_products = $storage->loadMultiple($related_ids);
        $variables['product_related_teasers'] = odesign_base_build_product_teasers($related_products);
      }
    }
  }

  // Offre volume configurable (scope univers/produits), 1ère règle applicable.
  $raw_rules = \Drupal::config('odesign_admin.settings')->get('promotion_volume_rules') ?? [];
  if (is_array($raw_rules)) {
    $normalized_rules = [];
    foreach ($raw_rules as $rule) {
      if (!is_array($rule) || empty($rule['enabled'])) {
        continue;
      }
      $scope = (string) ($rule['scope'] ?? 'life_occasion');
      if (!in_array($scope, ['life_occasion', 'product'], TRUE)) {
        continue;
      }
      $target_ids = array_values(array_filter(array_map('intval', (array) ($rule['target_ids'] ?? []))));
      $tiers = [];
      foreach ((array) ($rule['tiers'] ?? []) as $tier) {
        if (!is_array($tier)) {
          continue;
        }
        $threshold = (int) ($tier['threshold'] ?? 0);
        $discount = (float) ($tier['discount'] ?? 0);
        if ($threshold > 0 && $discount > 0) {
          $tiers[] = ['quantity' => $threshold, 'discount' => $discount];
        }
      }
      if (!$target_ids || !$tiers) {
        continue;
      }
      usort($tiers, static fn(array $a, array $b): int => $a['quantity'] <=> $b['quantity']);
      $normalized_rules[] = [
        'label' => trim((string) ($rule['label'] ?? 'Offre lot')),
        'scope' => $scope,
        'target_ids' => $target_ids,
        'tiers' => $tiers,
        'priority' => (int) ($rule['priority'] ?? 0),
      ];
    }
    usort($normalized_rules, static fn(array $a, array $b): int => $b['priority'] <=> $a['priority']);

    foreach ($normalized_rules as $rule) {
      $matches = FALSE;
      if ($rule['scope'] === 'product') {
        $matches = in_array((int) $product->id(), $rule['target_ids'], TRUE);
      }
      else {
        $matches = count(array_intersect($product_term_ids, $rule['target_ids'])) > 0;
      }
      if ($matches) {
        $variables['product_has_volume_offer'] = TRUE;
        $variables['product_volume_offer_label'] = $rule['label'];
        $variables['product_volume_offer_tiers'] = $rule['tiers'];
        break;
      }
    }
  }

  if (!$product->hasField('field_product_images')) {
    return;
  }

  $file_url_generator = \Drupal::service('file_url_generator');
  $full_style = ImageStyle::load('product_full');
  $thumb_style = ImageStyle::load('product_thumbnail');
  $gallery_items = [];

  foreach ($product->get('field_product_images')->referencedEntities() as $delta => $media) {
    if (
      !$media->hasField('field_media_image') ||
      $media->get('field_media_image')->isEmpty() ||
      !$media->get('field_media_image')->entity
    ) {
      continue;
    }

    $image = $media->get('field_media_image')->entity;
    $image_item = $media->get('field_media_image')->first();
    $uri = $image->getFileUri();

    $gallery_items[] = [
      'id'        => 'product-gallery-image-' . $delta,
      'alt'       => trim((string) $image_item?->get('alt')->getString()) ?: $media->label(),
      'main_src'  => $full_style ? $full_style->buildUrl($uri) : $file_url_generator->generateString($uri),
      'thumb_src' => $thumb_style ? $thumb_style->buildUrl($uri) : $file_url_generator->generateString($uri),
      'width'     => (int) ($image_item?->width ?? 0),
      'height'    => (int) ($image_item?->height ?? 0),
    ];
  }

  $variables['product_gallery_items'] = $gallery_items;
  $variables['product_gallery_count'] = count($gallery_items);
  $variables['product_gallery_has_multiple'] = count($gallery_items) > 1;

  // JSON-LD Product + og:image — injectés en <head> via #attached.
  $first_image_url = $gallery_items[0]['main_src'] ?? NULL;

  $json_ld = [
    '@context' => 'https://schema.org',
    '@type'    => 'Product',
    'name'     => $product->label(),
    'brand'    => ['@type' => 'Brand', 'name' => 'O'Design Création'],
    'url'      => $product->toUrl('canonical', ['absolute' => TRUE])->toString(),
  ];

  if ($product->hasField('body') && !$product->get('body')->isEmpty()) {
    $body_item = $product->get('body')->first();
    $summary = trim((string) ($body_item->summary ?: strip_tags((string) ($body_item->value ?? ''))));
    if ($summary !== '') {
      $json_ld['description'] = $summary;
    }
  }

  if ($gallery_items) {
    $json_ld['image'] = array_column($gallery_items, 'main_src');
  }

  $variation = $product->getDefaultVariation();
  if ($variation && $variation->getPrice()) {
    $json_ld['offers'] = [
      '@type'         => 'Offer',
      'price'         => $variation->getPrice()->getNumber(),
      'priceCurrency' => 'EUR',
      'availability'  => 'https://schema.org/InStock',
      'url'           => $product->toUrl('canonical', ['absolute' => TRUE])->toString(),
    ];
  }

  // Injecter data-ga4-product sur l'élément racine du produit pour l'event
  // GA4 view_item déclenché par ga4-ecommerce.js.
  $ga4_price = $variation && $variation->getPrice()
    ? (float) $variation->getPrice()->getNumber()
    : 0.0;
  $variables['attributes']['data-ga4-product'] = json_encode([
    'id'    => $product->id(),
    'name'  => $product->label(),
    'price' => $ga4_price,
  ], JSON_UNESCAPED_UNICODE);

  $variables['#attached']['html_head'][] = [
    [
      '#type'       => 'html_tag',
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'product_json_ld',
  ];

  if ($first_image_url) {
    $variables['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'meta',
        '#attributes' => ['property' => 'og:image', 'content' => $first_image_url],
      ],
      'og_image_product',
    ];
  }
}

/**
 * Charge les univers "Occasions de vie" publiés.
 *
 * @return \Drupal\taxonomy\TermInterface[]
 *   Les termes triés par poids puis nom.
 */
function odesign_base_load_life_occasion_terms(): array {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $term_ids = $term_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'life_occasion')
    ->condition('status', 1)
    ->sort('weight')
    ->sort('name')
    ->execute();

  if (!$term_ids) {
    return [];
  }

  return $term_storage->loadMultiple($term_ids);
}

/**
 * Charge des produits publiés liés à un univers.
 *
 * @param \Drupal\taxonomy\TermInterface $term
 *   Le terme d'univers.
 * @param int $limit
 *   Le nombre maximum de produits.
 *
 * @return \Drupal\commerce_product\Entity\ProductInterface[]
 *   Les produits trouvés.
 */
function odesign_base_load_products_for_life_occasion(TermInterface $term, int $limit = 6): array {
  $product_storage = \Drupal::entityTypeManager()->getStorage('commerce_product');
  $product_ids = $product_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('status', 1)
    ->condition('field_life_occasion.target_id', $term->id())
    ->sort('title')
    ->range(0, $limit)
    ->execute();

  if (!$product_ids) {
    return [];
  }

  return $product_storage->loadMultiple($product_ids);
}

/**
 * Compte les produits publiés liés à un univers.
 */
function odesign_base_count_products_for_life_occasion(TermInterface $term): int {
  return (int) \Drupal::entityTypeManager()->getStorage('commerce_product')->getQuery()
    ->accessCheck(TRUE)
    ->condition('status', 1)
    ->condition('field_life_occasion.target_id', $term->id())
    ->count()
    ->execute();
}

/**
 * Construit les teasers produits pour Twig.
 *
 * @param \Drupal\commerce_product\Entity\ProductInterface[] $products
 *   Les produits à rendre.
 *
 * @return array
 *   Un render array.
 */
function odesign_base_build_product_teasers(array $products): array {
  if (!$products) {
    return [];
  }

  return \Drupal::entityTypeManager()
    ->getViewBuilder('commerce_product')
    ->viewMultiple($products, 'teaser');
}

/**
 * Extrait une version courte d'un champ texte.
 */
function odesign_base_extract_term_text(TermInterface $term, string $field_name, int $max_length = 180): string {
  if (!$term->hasField($field_name) || $term->get($field_name)->isEmpty()) {
    return '';
  }

  $value = trim(strip_tags((string) $term->get($field_name)->value));
  if ($value === '') {
    return '';
  }

  return Unicode::truncate($value, $max_length, TRUE, TRUE);
}

/**
 * Extrait une liste simple depuis le champ de réassurance.
 *
 * @return string[]
 *   Une liste de points courts.
 */
function odesign_base_extract_reassurance_items(TermInterface $term): array {
  if (!$term->hasField('field_reassurance') || $term->get('field_reassurance')->isEmpty()) {
    return [];
  }

  $value = trim(strip_tags((string) $term->get('field_reassurance')->value));
  if ($value === '') {
    return [];
  }

  $lines = preg_split('/\r\n|\r|\n/', $value) ?: [];
  $items = [];
  foreach ($lines as $line) {
    $line = trim($line, " \t\n\r\0\x0B-•");
    if ($line !== '') {
      $items[] = $line;
    }
  }

  return $items;
}

/**
 * Fournit les relations éditoriales entre univers (maillage contrôlé).
 *
 * @param \Drupal\taxonomy\TermInterface $term
 *   Le terme univers courant.
 *
 * @return array<int, array{title:string,url:string,relationship:string}>
 *   Liste de liens liés.
 */
function odesign_base_build_related_life_occasion_links(TermInterface $term): array {
  $canonical_path = '/taxonomy/term/' . $term->id();
  $alias_manager = \Drupal::service('path_alias.manager');
  $current_alias = $alias_manager->getAliasByPath($canonical_path);

  $relations_by_alias = [
    '/occasions/mariage' => ['/occasions/pancarte-evenementielles'],
    '/occasions/pancarte-evenementielles' => ['/occasions/mariage'],
  ];

  if (empty($relations_by_alias[$current_alias])) {
    return [];
  }

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $links = [];

  foreach ($relations_by_alias[$current_alias] as $related_alias) {
    $related_path = $alias_manager->getPathByAlias($related_alias);
    if (!preg_match('#^/taxonomy/term/(\d+)$#', $related_path, $matches)) {
      continue;
    }
    $related_term = $term_storage->load((int) $matches[1]);
    if (!$related_term instanceof TermInterface || $related_term->bundle() !== 'life_occasion') {
      continue;
    }
    $links[] = [
      'title' => $related_term->label(),
      'url' => $related_term->toUrl()->toString(),
      'relationship' => $current_alias === '/occasions/pancarte-evenementielles'
        ? 'univers-principal-lie'
        : 'univers-secondaire-lie',
    ];
  }

  return $links;
}

/**
 * Détermine la meilleure couleur de texte pour une image.
 */
function odesign_base_detect_hero_text_mode(string $file_uri): string {
  $file_system = \Drupal::service('file_system');
  assert($file_system instanceof FileSystemInterface);
  $realpath = $file_system->realpath($file_uri);

  if (!$realpath || !is_readable($realpath)) {
    return 'light';
  }

  $image_data = @file_get_contents($realpath);
  if ($image_data === FALSE) {
    return 'light';
  }

  $source = @imagecreatefromstring($image_data);
  if (!$source) {
    return 'light';
  }

  $width = imagesx($source);
  $height = imagesy($source);
  $sample_width = min(24, max(1, $width));
  $sample_height = min(24, max(1, $height));
  $sample = imagecreatetruecolor($sample_width, $sample_height);

  if (!$sample) {
    imagedestroy($source);
    return 'light';
  }

  imagecopyresampled($sample, $source, 0, 0, 0, 0, $sample_width, $sample_height, $width, $height);

  $pixels = 0;
  $luminance_total = 0.0;
  for ($x = 0; $x < $sample_width; $x++) {
    for ($y = 0; $y < $sample_height; $y++) {
      $rgb = imagecolorat($sample, $x, $y);
      $red = ($rgb >> 16) & 0xFF;
      $green = ($rgb >> 8) & 0xFF;
      $blue = $rgb & 0xFF;
      $luminance_total += (0.299 * $red) + (0.587 * $green) + (0.114 * $blue);
      $pixels++;
    }
  }

  imagedestroy($sample);
  imagedestroy($source);

  if ($pixels === 0) {
    return 'light';
  }

  $average_luminance = $luminance_total / $pixels;
  return $average_luminance >= 150 ? 'dark' : 'light';
}

/**
 * Prépare les données visuelles du hero d'un univers.
 *
 * @return array{url: string|null, text_mode: string, has_image: bool}
 *   Les données de rendu du hero.
 */
function odesign_base_build_life_occasion_hero(TermInterface $term): array {
  $text_mode = 'light';
  if ($term->hasField('field_hero_text_mode') && !$term->get('field_hero_text_mode')->isEmpty()) {
    $value = (string) $term->get('field_hero_text_mode')->value;
    if (in_array($value, ['auto', 'light', 'dark'], TRUE)) {
      $text_mode = $value;
    }
  }

  if (!$term->hasField('field_hero_image') || $term->get('field_hero_image')->isEmpty()) {
    return [
      'url' => NULL,
      'text_mode' => 'dark',
      'has_image' => FALSE,
    ];
  }

  $file = $term->get('field_hero_image')->entity;
  if (!$file) {
    return [
      'url' => NULL,
      'text_mode' => 'dark',
      'has_image' => FALSE,
    ];
  }

  $file_url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
  $resolved_mode = $text_mode === 'auto'
    ? odesign_base_detect_hero_text_mode($file->getFileUri())
    : $text_mode;

  return [
    'url' => $file_url,
    'text_mode' => in_array($resolved_mode, ['light', 'dark'], TRUE) ? $resolved_mode : 'light',
    'has_image' => TRUE,
  ];
}

/**
 * Prépare les données visuelles du hero de la homepage.
 *
 * @return array{url: string|null, text_mode: string, has_image: bool}
 *   Les données de rendu du hero.
 */
function odesign_base_build_homepage_hero(): array {
  $settings = \Drupal::config('odesign_admin.settings');
  $hero_enabled = (bool) ($settings->get('homepage_hero_enable_image') ?? TRUE);
  if (!$hero_enabled) {
    return [
      'url' => NULL,
      'text_mode' => 'dark',
      'has_image' => FALSE,
    ];
  }

  $text_mode = (string) ($settings->get('homepage_hero_text_mode') ?? 'auto');
  if (!in_array($text_mode, ['auto', 'light', 'dark'], TRUE)) {
    $text_mode = 'auto';
  }

  $default_hero_url = odesign_base_theme_asset_url('media/home-hero-historique.png');
  $file_id = (int) ($settings->get('homepage_hero_image') ?? 0);
  if (!$file_id) {
    return [
      'url' => $default_hero_url,
      'text_mode' => 'light',
      'has_image' => (bool) $default_hero_url,
    ];
  }

  $file = \Drupal\file\Entity\File::load($file_id);
  if (!$file) {
    return [
      'url' => $default_hero_url,
      'text_mode' => 'light',
      'has_image' => (bool) $default_hero_url,
    ];
  }

  $resolved_mode = $text_mode === 'auto'
    ? odesign_base_detect_hero_text_mode($file->getFileUri())
    : $text_mode;

  return [
    'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
    'text_mode' => in_array($resolved_mode, ['light', 'dark'], TRUE) ? $resolved_mode : 'light',
    'has_image' => TRUE,
  ];
}

/**
 * Retourne l'URL publique d'un asset du thème si le fichier existe.
 */
function odesign_base_theme_asset_url(string $relative_path): ?string {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('odesign_base');
  $full_path = DRUPAL_ROOT . '/' . $theme_path . '/' . ltrim($relative_path, '/');
  if (!is_file($full_path)) {
    return NULL;
  }
  return base_path() . $theme_path . '/' . ltrim($relative_path, '/');
}

/**
 * Retourne l'URL publique d'un fichier à partir de son id.
 */
function odesign_base_file_url_from_id(int $file_id): ?string {
  if ($file_id <= 0) {
    return NULL;
  }
  $file = \Drupal\file\Entity\File::load($file_id);
  if (!$file) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->generateString($file->getFileUri());
}

/**
 * Prépare une carte d'univers pour la homepage.
 */
function odesign_base_build_life_occasion_card(TermInterface $term, int $product_limit = 3): array {
  $products = odesign_base_load_products_for_life_occasion($term, $product_limit);
  $hero = odesign_base_build_life_occasion_hero($term);
  $preview_image_url = $hero['url']
    ?: odesign_base_first_product_image_url($products)
    ?: odesign_base_theme_asset_url('media/home-hero-historique.png');

  return [
    'title' => $term->label(),
    'url' => $term->toUrl()->toString(),
    'intro' => odesign_base_extract_term_text($term, 'field_intro'),
    'hero_image_url' => $hero['url'],
    'preview_image_url' => $preview_image_url,
    'hero_text_mode' => $hero['text_mode'],
    'reassurance_items' => array_slice(odesign_base_extract_reassurance_items($term), 0, 3),
    'product_count' => odesign_base_count_products_for_life_occasion($term),
    'product_teasers' => odesign_base_build_product_teasers($products),
  ];
}

/**
 * Retourne la première image produit disponible pour un univers.
 */
function odesign_base_first_product_image_url(array $products): ?string {
  $file_url_generator = \Drupal::service('file_url_generator');
  foreach ($products as $product) {
    if (!$product instanceof ProductInterface) {
      continue;
    }
    if (!$product->hasField('field_product_images') || $product->get('field_product_images')->isEmpty()) {
      continue;
    }
    foreach ($product->get('field_product_images')->referencedEntities() as $media) {
      if (!$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
        continue;
      }
      $file = $media->get('field_media_image')->entity;
      if ($file instanceof \Drupal\file\FileInterface) {
        return $file_url_generator->generateString($file->getFileUri());
      }
    }
  }
  return NULL;
}

/**
 * Charge les derniers articles publiés.
 *
 * @return \Drupal\node\NodeInterface[]
 *   Articles publiés.
 */
function odesign_base_load_latest_articles(int $limit = 3): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->range(0, $limit)
    ->execute();
  if (!$ids) {
    return [];
  }
  return $storage->loadMultiple($ids);
}

/**
 * Prépare des cartes d'articles compactes pour la homepage.
 *
 * @return array<int, array{title: string, url: string, excerpt: string, image_url: ?string, image_alt: string}>
 *   Données d'articles.
 */
function odesign_base_build_latest_article_items(int $limit = 3): array {
  $items = [];
  foreach (odesign_base_load_latest_articles($limit) as $article) {
    $article = \Drupal::service('entity.repository')->getTranslationFromContext($article);
    $title = trim((string) $article->label());
    $url = $article->toUrl()->toString();
    $excerpt = '';
    if ($article->hasField('body') && !$article->get('body')->isEmpty()) {
      $raw = (string) ($article->get('body')->summary ?: $article->get('body')->value);
      $excerpt = trim(\Drupal\Component\Utility\Html::decodeEntities(strip_tags($raw)));
    }
    if (mb_strlen($excerpt) > 140) {
      $excerpt = rtrim(mb_substr($excerpt, 0, 137)) . '...';
    }
    $image_url = NULL;
    $image_alt = $title;
    if ($article->hasField('field_image') && !$article->get('field_image')->isEmpty()) {
      $image_field_item = $article->get('field_image')->first();
      $image_entity = $image_field_item?->entity;
      if ($image_entity instanceof \Drupal\file\FileInterface) {
        $image_url = \Drupal::service('file_url_generator')->generateString($image_entity->getFileUri());
        $alt = trim((string) ($image_field_item->alt ?? ''));
        if ($alt !== '') {
          $image_alt = $alt;
        }
      }
      elseif ($image_entity && $image_entity->hasField('field_media_image') && !$image_entity->get('field_media_image')->isEmpty()) {
        $media_image_item = $image_entity->get('field_media_image')->first();
        $file = $media_image_item?->entity;
        if ($file instanceof \Drupal\file\FileInterface) {
          $image_url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
          $alt = trim((string) ($media_image_item->alt ?? ''));
          if ($alt !== '') {
            $image_alt = $alt;
          }
        }
      }
    }
    $items[] = [
      'title' => $title,
      'url' => $url,
      'excerpt' => $excerpt,
      'image_url' => $image_url,
      'image_alt' => $image_alt,
    ];
  }
  return $items;
}

/**
 * Implements hook_preprocess_page().
 */
function odesign_base_preprocess_page(array &$variables): void {
  $is_admin = \Drupal::service('router.admin_context')->isAdminRoute();

  if ($is_admin) {
    $variables['attributes']['class'][] = 'page-admin';
  }

  // Variables compte client — header connexion / espace personnel.
  $account = \Drupal::currentUser();
  $variables['is_gestionnaire'] = $account->hasRole('gestionnaire_boutique') || $account->hasRole('administrator');
  if ($account->isAuthenticated()) {
    $uid = $account->id();
    $variables['user_orders_url']  = Url::fromUri("internal:/user/{$uid}/orders")->toString();
    $variables['user_profile_url'] = Url::fromUri("internal:/user/{$uid}")->toString();
    $variables['user_logout_url']  = Url::fromRoute('user.logout')->toString();
  }
  else {
    $variables['user_register_url'] = Url::fromRoute('user.register')->toString();
  }

  // Badge panier — nombre total d'articles dans le panier actif.
  $cart_count = 0;
  if (\Drupal::moduleHandler()->moduleExists('commerce_cart')) {
    try {
      $store = \Drupal::entityTypeManager()->getStorage('commerce_store')->loadDefault();
      $carts = \Drupal::service('commerce_cart.cart_provider')->getCarts(NULL, $store);
      foreach ($carts as $cart) {
        foreach ($cart->getItems() as $item) {
          $cart_count += (int) $item->getQuantity();
        }
      }
      // Cache par user + session — invalidé par le tag commerce_order.
      $variables['#cache']['contexts'][] = 'user';
      $variables['#cache']['contexts'][] = 'session';
      $variables['#cache']['tags'][] = 'commerce_order';
    }
    catch (\Exception $e) {
      \Drupal::logger('odesign')->warning('Cart badge error: @msg', ['@msg' => $e->getMessage()]);
    }
  }
  $variables['cart_count'] = $cart_count;

  // Bandeau newsletter : injecté sur toutes les pages publiques.
  if (!$is_admin && \Drupal::moduleHandler()->moduleExists('simplenews')) {
    try {
      $block_manager = \Drupal::service('plugin.manager.block');
      $nl_block = $block_manager->createInstance('simplenews_subscription_block', [
        'newsletters'         => ['nouveautes_atelier' => 'nouveautes_atelier'],
        'default_newsletters' => ['nouveautes_atelier' => 'nouveautes_atelier'],
        'unique_id'           => 'newsletter_footer_strip',
      ]);
      $variables['newsletter_form'] = $nl_block->build();
    }
    catch (\Exception) {
      $variables['newsletter_form'] = NULL;
    }
  }
  else {
    $variables['newsletter_form'] = NULL;
  }

  $current_route = \Drupal::routeMatch()->getRouteName();
  $variables['is_catalogue_page'] = ($current_route === 'view.catalogue.page_catalogue');
  if ($variables['is_catalogue_page']) {
    $variables['catalogue_contact_url'] = Url::fromUri('internal:/contact')->toString();
  }

  $current_path = \Drupal::service('path.current')->getPath();
  $current_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $request_path = \Drupal::request()->getPathInfo();
  $variables['is_contact_page'] = ($current_alias === '/contact' || $request_path === '/contact');
  if ($variables['is_contact_page']) {
    $variables['attributes']['class'][] = 'page-contact';
    $shop_contact_email = (string) (\Drupal::config('odesign_admin.settings')->get('shop_contact_email') ?? '');
    $contact_email = $shop_contact_email !== '' ? $shop_contact_email : 'odesigncrea@gmail.com';
    $variables['contact_email'] = $contact_email;
    $variables['contact_mailto'] = 'mailto:' . $contact_email;
    $variables['contact_email_b64'] = base64_encode($contact_email);
    $variables['contact_catalogue_url'] = Url::fromUri('internal:/produits')->toString();

    // Formulaire de contact (stocké en DB via contact_storage).
    $contact_form_entity = \Drupal\contact\Entity\ContactForm::load('atelier_contact');
    if ($contact_form_entity) {
      $message = \Drupal::entityTypeManager()
        ->getStorage('contact_message')
        ->create(['contact_form' => $contact_form_entity->id()]);
      $variables['contact_form'] = \Drupal::service('entity.form_builder')
        ->getForm($message);
    }
  }

  $route_term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if ($route_term instanceof TermInterface && $route_term->bundle() === 'life_occasion') {
    $variables['attributes']['class'][] = 'page-life-occasion';
  }

  if (empty($variables['is_front'])) {
    return;
  }

  $terms = odesign_base_load_life_occasion_terms();
  if (!$terms) {
    return;
  }

  $variables['front_life_occasion_cards'] = array_map(
    static fn(TermInterface $term) => odesign_base_build_life_occasion_card($term, 3),
    $terms
  );
  $hero = odesign_base_build_homepage_hero();
  $variables['front_hero_image_url'] = $hero['url'];
  $variables['front_hero_text_mode'] = $hero['text_mode'];
  $variables['front_hero_has_image'] = $hero['has_image'];

  // Préchargement LCP : si une image hero est configurée, on injecte un
  // <link rel="preload" as="image"> en <head> pour que le navigateur la
  // charge en priorité avant de parser le CSS background-image.
  if (!empty($hero['url'])) {
    $variables['page']['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'link',
        '#attributes' => [
          'rel'  => 'preload',
          'as'   => 'image',
          'href' => $hero['url'],
        ],
      ],
      'homepage_hero_preload',
    ];
  }
  $first_term = reset($terms);
  if ($first_term instanceof TermInterface) {
    $variables['front_primary_life_occasion_url'] = $first_term->toUrl()->toString();
  }
  $variables['front_catalogue_url'] = Url::fromUri('internal:/produits')->toString();

  $settings = \Drupal::config('odesign_admin.settings');
  $default_founder_text = "Je m’appelle Océane, j’ai 22 ans, je suis mariée et maman d’un petit garçon.\n\nEn 2023, j’ai créé mon entreprise avec un rêve simple mais essentiel : construire une vie professionnelle qui me permette d’être présente pour ma famille et pour l’éducation de mon enfant.\n\nAujourd’hui, je vis de mon travail passion, un projet né du cœur, qui me ressemble et qui donne du sens à chaque journée.";
  $default_video_text = 'Une vidéo réelle de fabrication pour montrer le niveau de finition, la précision de la gravure et le soin apporté aux créations.';

  $founder_text = trim((string) ($settings->get('homepage_story_founder_text') ?: $default_founder_text));
  $video_text = trim((string) ($settings->get('homepage_story_video_text') ?: $default_video_text));
  $variables['front_story_founder_title'] = (string) ($settings->get('homepage_story_founder_title') ?: 'Un atelier incarné, un travail de cœur');
  $variables['front_story_founder_text_lines'] = array_values(array_filter(preg_split('/\R\R+/', $founder_text) ?: []));
  $variables['front_story_video_title'] = (string) ($settings->get('homepage_story_video_title') ?: 'Réalisation d’un arbre de vie');
  $variables['front_story_video_text'] = $video_text;
  $variables['front_story_founder_image_url'] = odesign_base_file_url_from_id((int) ($settings->get('homepage_story_founder_image') ?? 0));
  $variables['front_story_video_file_url'] = odesign_base_file_url_from_id((int) ($settings->get('homepage_story_video_file') ?? 0));
  $variables['front_story_video_poster_url'] = odesign_base_file_url_from_id((int) ($settings->get('homepage_story_video_poster') ?? 0));

  $variables['front_featured_life_occasions'] = array_slice($variables['front_life_occasion_cards'], 0, 4);
  $variables['front_latest_articles'] = odesign_base_build_latest_article_items(3);

  // Campagne saisonnière "en cours" — widget homepage.
  // Affiche la campagne la plus récente avec promote=1 et status=1.
  $variables['front_campagne'] = NULL;
  $campagne_storage = \Drupal::entityTypeManager()->getStorage('node');
  $campagne_nids = $campagne_storage->getQuery()
    ->condition('type', 'campagne')
    ->condition('status', 1)
    ->condition('promote', 1)
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();
  if (!empty($campagne_nids)) {
    /** @var \Drupal\node\NodeInterface $campagne_node */
    $campagne_node = $campagne_storage->load(reset($campagne_nids));
    if ($campagne_node) {
      $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
      $campagne_hero_render = [];
      if (!$campagne_node->get('field_campagne_image_hero')->isEmpty()) {
        $campagne_hero_render = $view_builder->viewField(
          $campagne_node->get('field_campagne_image_hero'), [
            'label'    => 'hidden',
            'type'     => 'image',
            'settings' => ['image_style' => 'large', 'image_link' => ''],
          ]
        );
      }
      $campagne_cta_label = $campagne_node->get('field_campagne_cta_label')->value ?: t('Découvrir la campagne');
      $campagne_cta_url   = $campagne_node->get('field_campagne_cta_url')->uri ?: $campagne_node->toUrl()->toString();
      $variables['front_campagne'] = [
        '#theme'     => 'campagne_en_cours_widget',
        '#node'      => $campagne_node,
        '#title'     => $campagne_node->label(),
        '#hero'      => $campagne_hero_render,
        '#cta_label' => $campagne_cta_label,
        '#cta_url'   => $campagne_cta_url,
        '#cache'     => [
          'tags'     => \Drupal\Core\Cache\Cache::mergeTags(['node_list:campagne'], $campagne_node->getCacheTags()),
          'contexts' => ['url.path'],
        ],
        '#attached'  => ['library' => ['odesign_base/campagnes']],
      ];
    }
  }

  // Section "Comment ça marche" — 3 étapes administrables.
  $methode_steps = [];
  for ($i = 1; $i <= 3; $i++) {
    $defaults = [
      1 => ['title' => 'Je personnalise', 'desc' => 'Choisissez votre création et indiquez-nous le texte, le prénom ou le motif souhaité.', 'icon' => 'ph-pencil-simple'],
      2 => ['title' => "L'atelier crée", 'desc' => 'Océane grave et découpe à la main votre pièce dans son atelier. Chaque création est unique.', 'icon' => 'ph-scissors'],
      3 => ['title' => 'Je reçois ma création', 'desc' => 'Votre commande est soigneusement emballée et expédiée ou disponible en retrait atelier.', 'icon' => 'ph-gift'],
    ];
    $methode_steps[] = [
      'num'   => $i,
      'title' => (string) ($settings->get("homepage_methode_step{$i}_title") ?: $defaults[$i]['title']),
      'desc'  => (string) ($settings->get("homepage_methode_step{$i}_desc")  ?: $defaults[$i]['desc']),
      'icon'  => (string) ($settings->get("homepage_methode_step{$i}_icon")  ?: $defaults[$i]['icon']),
    ];
  }
  $variables['front_methode_title']    = (string) ($settings->get('homepage_methode_title')    ?: 'Comment ça marche ?');
  $variables['front_methode_subtitle'] = (string) ($settings->get('homepage_methode_subtitle') ?: "Recevoir une création personnalisée, c'est simple et rapide.");
  $variables['front_methode_steps']    = $methode_steps;
}

/**
 * Implements hook_preprocess_menu().
 */
function odesign_base_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'main') {
    return;
  }

  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  $request_path = \Drupal::request()->getPathInfo();
  $alias_manager = \Drupal::service('path_alias.manager');
  $current_route = \Drupal::routeMatch()->getRouteName();
  $existing_urls = [];
  $filtered_items = [];
  foreach ($variables['items'] ?? [] as $item) {
    $item_title = mb_strtolower(trim((string) ($item['title'] ?? '')));
    if (!empty($item['url']) && $item['url'] instanceof Url) {
      $item_url = $item['url']->toString();
      $existing_urls[] = $item_url;
      // Le lien "Boutique" est redondant avec la homepage/catalogue.
      // On centralise l'accès catalogue dans le dropdown "Univers".
      if ($item_url === '/produits' || $item_title === 'boutique') {
        continue;
      }
    }
    $filtered_items[] = $item;
  }
  $variables['items'] = $filtered_items;

  $route_term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  $variables['life_occasion_links'] = [];

  foreach (odesign_base_load_life_occasion_terms() as $term) {
    $url = $term->toUrl();
    $url_string = $url->toString();
    if (in_array($url_string, $existing_urls, TRUE)) {
      continue;
    }

    $canonical_path = '/taxonomy/term/' . $term->id();
    $alias_path = $alias_manager->getAliasByPath($canonical_path);
    $is_active = $current_route === 'entity.taxonomy_term.canonical' && (
      $route_term instanceof TermInterface
      && $route_term->bundle() === 'life_occasion'
      && (int) $route_term->id() === (int) $term->id()
    );

    $variables['life_occasion_links'][] = [
      'title' => $term->label(),
      'url' => $url,
      'in_active_trail' => $is_active,
      'attributes' => new \Drupal\Core\Template\Attribute(['class' => array_filter(['menu-item', 'menu-item--life-occasion', $is_active ? 'menu-item--active' : NULL])]),
      'below' => [],
    ];
  }
}

/**
 * Implements hook_preprocess_taxonomy_term().
 */
function odesign_base_preprocess_taxonomy_term(array &$variables): void {
  if (empty($variables['term']) || !$variables['term'] instanceof TermInterface) {
    return;
  }

  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $variables['term'];
  if ($term->bundle() !== 'life_occasion') {
    return;
  }

  // Affiche un volume large pour éviter des fiches "orphelines" côté visiteur.
  $products = odesign_base_load_products_for_life_occasion($term, 96);
  $hero = odesign_base_build_life_occasion_hero($term);

  $variables['life_occasion_title'] = $term->label();
  $variables['life_occasion_intro'] = odesign_base_extract_term_text($term, 'field_intro', 260);
  $variables['life_occasion_reassurance_items'] = odesign_base_extract_reassurance_items($term);
  $variables['life_occasion_product_count'] = odesign_base_count_products_for_life_occasion($term);
  $variables['life_occasion_product_teasers'] = odesign_base_build_product_teasers($products);
  $variables['life_occasion_catalogue_url'] = Url::fromUri('internal:/produits')->toString();
  $variables['life_occasion_hero_image_url'] = $hero['url'];
  $variables['life_occasion_hero_text_mode'] = $hero['text_mode'];
  $variables['life_occasion_hero_has_image'] = $hero['has_image'];
  $variables['life_occasion_related_links'] = odesign_base_build_related_life_occasion_links($term);

  $alias_manager = \Drupal::service('path_alias.manager');
  $current_alias = $alias_manager->getAliasByPath('/taxonomy/term/' . $term->id());
  $variables['life_occasion_is_secondary_measured'] = ($current_alias === '/occasions/pancarte-evenementielles');
  $variables['life_occasion_lot_offer_note'] = $variables['life_occasion_is_secondary_measured']
    ? (string) t('Univers secondaire mesuré : cette page peut porter des offres en lot dédiées aux événements, sans casser la navigation principale.')
    : '';

  // Injection head : preload hero, og:image, JSON-LD BreadcrumbList.
  if (!empty($hero['url'])) {
    $variables['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'link',
        '#attributes' => ['rel' => 'preload', 'as' => 'image', 'href' => $hero['url']],
      ],
      'life_occasion_hero_preload_' . $term->id(),
    ];
    $variables['#attached']['html_head'][] = [
      [
        '#type'       => 'html_tag',
        '#tag'        => 'meta',
        '#attributes' => ['property' => 'og:image', 'content' => $hero['url']],
      ],
      'og_image_life_occasion_' . $term->id(),
    ];
  }

  $base_url  = \Drupal::request()->getSchemeAndHttpHost();
  $term_url  = $term->toUrl('canonical', ['absolute' => TRUE])->toString();
  $breadcrumb_json_ld = [
    '@context'        => 'https://schema.org',
    '@type'           => 'BreadcrumbList',
    'itemListElement' => [
      ['@type' => 'ListItem', 'position' => 1, 'name' => (string) t('Accueil'), 'item' => $base_url . '/'],
      ['@type' => 'ListItem', 'position' => 2, 'name' => $term->label(), 'item' => $term_url],
    ],
  ];
  $variables['#attached']['html_head'][] = [
    [
      '#type'       => 'html_tag',
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($breadcrumb_json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'life_occasion_breadcrumb_json_ld_' . $term->id(),
  ];
}

/**
 * Implements hook_preprocess_feed_icon().
 */
function odesign_base_preprocess_feed_icon(array &$variables): void {
  if (!isset($variables['title']) || !is_string($variables['title'])) {
    return;
  }

  $variables['title'] = Html::decodeEntities($variables['title']);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Ajoute "Mot de passe oublié ?" et un CTA "Créer un compte" sous le bouton.
 */
function odesign_base_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  $form['forgot_password'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#value' => \Drupal\Core\Link::createFromRoute(
      t('Mot de passe oublié ?'),
      'user.pass'
    )->toString(),
    '#attributes' => ['class' => ['login-forgot-password']],
    '#weight' => 100,
  ];

  $register_url = \Drupal\Core\Url::fromRoute('user.register')->toString();
  $form['create_account'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#value' => '<p class="login-create-account__label">' . t('Première visite ?') . '</p>'
      . '<a href="' . $register_url . '" class="btn btn--outline login-create-account__btn">'
      . t('Créer un compte') . '</a>',
    '#attributes' => ['class' => ['login-create-account']],
    '#weight' => 101,
  ];
}

/**
 * Implements hook_preprocess_node().
 *
 * Injecte un JSON-LD Article en <head> pour les guides et articles en mode full.
 */
function odesign_base_preprocess_node(array &$variables): void {
  if (
    empty($variables['node']) ||
    !$variables['node'] instanceof \Drupal\node\NodeInterface
  ) {
    return;
  }

  $node = $variables['node'];
  if (!in_array($node->bundle(), ['guide', 'article'], TRUE) || $variables['view_mode'] !== 'full') {
    return;
  }

  $node_url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
  $base_url  = \Drupal::request()->getSchemeAndHttpHost();

  $json_ld = [
    '@context'      => 'https://schema.org',
    '@type'         => 'Article',
    'headline'      => $node->label(),
    'url'           => $node_url,
    'publisher'     => [
      '@type' => 'Organization',
      'name'  => 'O'Design Création',
      'url'   => $base_url . '/',
    ],
  ];

  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    $summary   = trim((string) ($body_item->summary ?: strip_tags((string) ($body_item->value ?? ''))));
    if ($summary !== '') {
      $json_ld['description'] = $summary;
    }
  }

  if ($node->hasField('created')) {
    $json_ld['datePublished'] = date('c', (int) $node->getCreatedTime());
  }
  if ($node->hasField('changed')) {
    $json_ld['dateModified'] = date('c', (int) $node->getChangedTime());
  }

  // Inject image for article and guide bundles (field_image).
  if (in_array($node->bundle(), ['article', 'guide'], TRUE) && $node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    /** @var \Drupal\file\FileInterface|null $file */
    $file = $node->get('field_image')->entity?->get('field_media_image')?->entity
      ?? $node->get('field_image')->entity;
    if ($file instanceof \Drupal\file\FileInterface) {
      $json_ld['image'] = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
    }
  }

  $variables['#attached']['html_head'][] = [
    [
      '#type'       => 'html_tag',
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'node_article_json_ld_' . $node->id(),
  ];
}

/**
 * Implements hook_theme_suggestions_user_alter().
 *
 * Ajoute la suggestion de view mode (ex. user--full.html.twig) que
 * Drupal 11 ne génère plus automatiquement dans preprocessUser().
 */
function odesign_base_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? NULL;
  if ($view_mode) {
    $suggestions[] = 'user__' . $view_mode;
  }
}

/**
 * Implements hook_preprocess_user().
 *
 * Injecte les variables de navigation du tableau de bord client.
 */
function odesign_base_preprocess_user(array &$variables): void {
  $account = $variables['user'];
  if (!($account instanceof \Drupal\user\UserInterface)) {
    return;
  }
  $uid = $account->id();
  $variables['user_orders_url']  = \Drupal\Core\Url::fromRoute('view.commerce_user_orders.order_page', ['user' => $uid])->toString();
  $variables['user_profile_url'] = \Drupal\Core\Url::fromRoute('entity.user.edit_form', ['user' => $uid])->toString();
  $variables['user_logout_url']  = \Drupal\Core\Url::fromRoute('user.logout')->toString();

  // Commandes récentes (max 3) pour le dashboard.
  try {
    $order_storage = \Drupal::entityTypeManager()->getStorage('commerce_order');
    $order_ids = $order_storage->getQuery()
      ->condition('uid', $uid)
      ->condition('state', 'draft', '!=')
      ->sort('placed', 'DESC')
      ->range(0, 3)
      ->accessCheck(FALSE)
      ->execute();

    $recent = [];
    foreach ($order_storage->loadMultiple($order_ids) as $order) {
      /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
      $number_label = $order->getOrderNumber() ?: ('#' . $order->id());
      $placed = $order->getPlacedTime();
      $recent[] = [
        'id'               => $order->id(),
        'number_label'     => $number_label,
        'state_id'         => $order->getState()->getId(),
        'state_label'      => $order->getState()->getLabel(),
        'url'              => \Drupal\Core\Url::fromRoute('entity.commerce_order.user_view', [
        'user'           => $order->getCustomerId(),
        'commerce_order' => $order->id(),
      ])->toString(),
        'placed_formatted' => $placed ? \Drupal::service('date.formatter')->format($placed, 'custom', 'd/m/Y') : '',
        'total'            => $order->getTotalPrice() ? \Drupal::service('commerce_price.currency_formatter')->format($order->getTotalPrice()->getNumber(), $order->getTotalPrice()->getCurrencyCode()) : '',
      ];
    }
    $variables['recent_orders'] = $recent;
  }
  catch (\Exception $e) {
    $variables['recent_orders'] = [];
  }
}

/**
 * Implements hook_preprocess_views_view_table() for commerce_user_orders.
 *
 * Injecte les entités commandes dans les lignes pour le template carte.
 */
function odesign_base_preprocess_views_view_table__commerce_user_orders(array &$variables): void {
  $view = $variables['view'];
  foreach ($view->result as $index => $row) {
    /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
    $order = $row->_entity ?? NULL;
    if (!$order) {
      continue;
    }
    $order_number = $order->getOrderNumber() ?: ('#' . $order->id());
    $state        = $order->getState();
    $variables['rows'][$index]['order_entity'] = [
      'id'           => $order->id(),
      'number_label' => $order_number,
      'state_id'     => $state->getId(),
      'state_label'  => $state->getLabel(),
      'url'          => \Drupal\Core\Url::fromRoute('entity.commerce_order.user_view', [
        'user'           => $order->getCustomerId(),
        'commerce_order' => $order->id(),
      ])->toString(),
    ];
  }
}

/**
 * Implements hook_preprocess_page_title().
 *
 * Remplace le titre "username" par "Mon compte" sur la page profil client.
 */
function odesign_base_preprocess_page_title(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'entity.user.canonical') {
    $current_user = \Drupal::currentUser();
    $uid = \Drupal::routeMatch()->getRawParameter('user');
    if ($current_user->id() == $uid) {
      $variables['title'] = t('Mon compte');
    }
  }
}
