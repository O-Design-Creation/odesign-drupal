{#
/**
 * @file
 * node--campagne--full.html.twig
 *
 * Template campagne saisonnière — vue complète.
 */
#}
{%
  set classes = [
    'node',
    'node--type-campagne',
    'node--view-mode-full',
    'campagne-full',
  ]
%}
{%- set couleur = node.field_campagne_couleur.value ? node.field_campagne_couleur.value : '#BB7570' -%}

<article{{ attributes.addClass(classes) }}>

  {# Hero fullwidth #}
  {%- if content.field_campagne_image_hero|render|striptags|trim is not empty -%}
    <div class="campagne-hero">
      {{- content.field_campagne_image_hero -}}
      <div class="campagne-hero__overlay" style="--campagne-couleur: {{ couleur }};"></div>
    </div>
  {%- endif -%}

  <div class="campagne-full__inner">

    {# Titre de la campagne — h2 sémantique, le h1 est rendu par le bloc page-title Drupal #}
    <h2 class="campagne-full__title" style="color: {{ couleur }};">
      {{- label -}}
    </h2>

    {# Corps de texte #}
    {%- if content.body|render|striptags|trim is not empty -%}
      <div class="campagne-full__body field--name-body">
        {{- content.body -}}
      </div>
    {%- endif -%}

    {# Produits mis en avant #}
    {%- if content.field_campagne_produits|render|striptags|trim is not empty -%}
      <section class="campagne-full__produits" aria-labelledby="campagne-produits-titre">
        <h2 id="campagne-produits-titre" class="campagne-full__section-title" style="color: {{ couleur }};">
          {{ 'Produits mis en avant'|t }}
        </h2>
        <div class="campagne-produits-grid">
          {{- content.field_campagne_produits -}}
        </div>
      </section>
    {%- endif -%}

    {# CTA button #}
    {%- set cta_label = node.field_campagne_cta_label.value -%}
    {%- set cta_url = node.field_campagne_cta_url.uri -%}
    {%- if cta_label and cta_url -%}
      <div class="campagne-full__cta">
        <a href="{{ cta_url }}" class="btn btn--primary campagne-cta-btn">
          {{- cta_label|e -}}
        </a>
      </div>
    {%- endif -%}

  </div>

</article>
