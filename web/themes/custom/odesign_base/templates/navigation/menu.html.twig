{#
/**
 * @file
 * menu.html.twig — Navigation principale odesign_base
 *
 * Note a11y : role="list" retiré — axe-core 4.11 exige role="listitem"
 * explicite sur tous les <li> ce qui est redondant avec le HTML natif.
 * La sémantique <ul>/<li> native est suffisante pour les AT modernes.
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0, life_occasion_links|default([])) }}

{% macro menu_links(items, attributes, menu_level, life_occasion_links) %}
  {% import _self as menus %}
  {% set extra_links = menu_level == 0 and life_occasion_links is defined ? life_occasion_links : [] %}
  {% if items or extra_links %}
    {% if menu_level == 0 %}
      <ul{{ attributes }}>
    {% else %}
      <ul>
    {% endif %}
    {% for item in extra_links %}
      {% set extra_link_is_active = item.in_active_trail %}
      {% set extra_link_classes = ['menu-item__link'] %}
      {% if extra_link_is_active %}
        {% set extra_link_classes = extra_link_classes|merge(['is-active']) %}
      {% endif %}
      <li{{ item.attributes.addClass('menu-item') }}>
        {{ link(item.title, item.url, {
          'class': extra_link_classes,
          'aria-current': extra_link_is_active ? 'page' : null
        }) }}
      </li>
    {% endfor %}
    {% for item in items %}
      {% set item_link_classes = ['menu-item__link'] %}
      {% if item.in_active_trail %}
        {% set item_link_classes = item_link_classes|merge(['is-active']) %}
      {% endif %}
      <li{{ item.attributes.addClass('menu-item') }}>
        {{ link(item.title, item.url, {
          'class': item_link_classes,
          'aria-current': item.in_active_trail ? 'page' : null
        }) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1, []) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
