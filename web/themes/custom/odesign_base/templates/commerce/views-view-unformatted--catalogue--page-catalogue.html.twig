{#
/**
 * @file
 * views-view-unformatted--catalogue--page-catalogue.html.twig
 *
 * Wrapper HTML de la vue catalogue — applique la classe .product-grid.
 *
 * Variables :
 * - title: titre de la vue
 * - rows: lignes de la vue (cartes produits)
 * - options: options de la vue
 */
#}
{% if title %}
  <header class="catalogue__header">
    <h1 class="catalogue__title">{{ title }}</h1>
    <p class="catalogue__intro">
      {{ 'Choisissez votre création personnalisée et, si besoin, utilisez le lien contact pour une demande spécifique.'|t }}
    </p>
    <p class="catalogue__contact">
      <a href="/contact" class="catalogue__contact-link">{{ 'Une question ? Contactez l’atelier'|t }}</a>
    </p>
  </header>
{% endif %}

<div class="product-grid">
  {% for row in rows %}
    {{- row.content -}}
  {% endfor %}
</div>
