{#
/**
 * @file
 * Template de confirmation de commande — O'Design Création.
 *
 * Variables disponibles :
 * - order_entity : entité CommercOrderInterface
 * - message      : message de confirmation (configuré dans le flow)
 * - payment_instructions : instructions de paiement (virement, etc.)
 */
#}
{% set order_number = order_entity.getOrderNumber() %}
{% set uid         = order_entity.getCustomerId() %}
{% set orders_url  = path('view.commerce_user_orders.order_page', {'user': uid}) %}
{% set order_url   = path('entity.commerce_order.user_view', {'user': uid, 'commerce_order': order_entity.id()}) %}

<div class="checkout-complete checkout-complete--branded">

  <div class="checkout-complete__icon" aria-hidden="true">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8B6151"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
  </div>

  <div class="checkout-complete__message">
    {{- message -}}
  </div>

  <div class="checkout-complete__reassurance">
    <ul class="checkout-complete__reassurance-list" aria-label="{{ 'Informations de suivi'|t }}">
      <li>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {{ 'Fabrication artisanale sous 5 à 7 jours ouvrés.'|t }}
      </li>
      <li>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        {{ 'Un email de confirmation vous a été envoyé.'|t }}
      </li>
      <li>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.77 13 19.79 19.79 0 0 1 1.7 4.42 2 2 0 0 1 3.67 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.4a16 16 0 0 0 6.29 6.29l1.46-1.46a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {{ 'Une question ? Contactez l\'atelier sur notre page contact.'|t }}
      </li>
    </ul>
  </div>

  {% if payment_instructions %}
    <div class="checkout-complete__payment-instructions">
      <h2>{{ 'Instructions de paiement'|t }}</h2>
      {{ payment_instructions }}
    </div>
  {% endif %}

  <div class="checkout-complete__actions">
    {% if order_number %}
      <a href="{{ order_url }}" class="btn btn--primary">
        {{ 'Voir ma commande N° @n'|t({'@n': order_number}) }}
      </a>
    {% else %}
      <a href="{{ orders_url }}" class="btn btn--primary">
        {{ 'Voir mes commandes'|t }}
      </a>
    {% endif %}
    <a href="/produits" class="btn btn--secondary">{{ 'Retour à la boutique'|t }}</a>
  </div>

</div>
