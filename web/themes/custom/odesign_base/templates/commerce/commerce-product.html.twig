{#
/**
 * @file
 * commerce-product.html.twig
 *
 * Fiche produit complète — layout 2 colonnes.
 * Icônes : Phosphor Icons (webfont) — pas d'emojis.
 */
#}
{%
  set classes = [
    'product-detail',
    'product-detail--' ~ product_entity.bundle(),
  ]
%}
<article{{ attributes.addClass(classes) }}>

  <div class="product-layout">

    {# Colonne gauche : galerie images #}
    <div class="product-gallery">
      {%- if product_gallery_items is not empty -%}
        <div class="product-gallery__frame">
          <div class="product-gallery__main" id="product-gallery-main">
            {% for item in product_gallery_items %}
              <figure
                class="product-gallery__slide{{ loop.first ? ' is-active' : '' }}"
                id="{{ item.id }}"
                data-gallery-slide
                {% if not loop.first %}hidden{% endif %}
              >
                <img
                  src="{{ item.main_src }}"
                  alt="{{ item.alt }}"
                  loading="{{ loop.first ? 'eager' : 'lazy' }}"
                  decoding="async"
                >
              </figure>
            {% endfor %}
          </div>

          {% if product_gallery_has_multiple %}
            <div class="product-gallery__toolbar">
              <p class="product-gallery__count">
                {{ product_gallery_count }} {{ product_gallery_count > 1 ? 'vues'|t : 'vue'|t }}
              </p>
              <div class="product-gallery__hint">{{ 'Sélectionnez une vignette pour changer de vue'|t }}</div>
            </div>

            <div
              class="product-gallery__thumbs"
              role="tablist"
              aria-label="{{ 'Galerie produit'|t }}"
            >
              {% for item in product_gallery_items %}
                <button
                  type="button"
                  class="product-gallery__thumb{{ loop.first ? ' is-active' : '' }}"
                  data-gallery-trigger
                  data-gallery-target="{{ item.id }}"
                  role="tab"
                  aria-controls="{{ item.id }}"
                  aria-selected="{{ loop.first ? 'true' : 'false' }}"
                  aria-label="{{ 'Afficher l’image %position sur %total'|t({
                    '%position': loop.index,
                    '%total': product_gallery_count
                  }) }}"
                >
                  <img
                    src="{{ item.thumb_src }}"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  >
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {%- else -%}
        <div class="product-gallery__placeholder" aria-label="{{ 'Image non disponible'|t }}" role="img">
          <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="400" height="400" fill="var(--color-bg-alt)"/>
            <path d="M140 260 L200 140 L260 260Z" fill="var(--color-brand-light)"/>
          </svg>
        </div>
      {%- endif -%}
    </div>

    {# Colonne droite : informations produit #}
    <div class="product-info">
      <h2 class="product-detail__title">{{ product_entity.label }}</h2>

      {# Prix #}
      {%- set variation = product_entity.getDefaultVariation() -%}
      {%- if variation and variation.getPrice() -%}
        <div class="product-detail__price" itemprop="price" content="{{ variation.getPrice().getNumber() }}">
          {{ variation.getPrice().getNumber()|number_format(2, ',', ' ') }}&nbsp;€
        </div>
        {% if variation.getPrice().getNumber() >= 50 %}
          <p class="product-detail__shipping-free">
            <i class="ph ph-gift" aria-hidden="true"></i>
            {{ 'Livraison offerte pour cette commande'|t }}
          </p>
        {% else %}
          <p class="product-detail__shipping-cost">
            <i class="ph ph-truck" aria-hidden="true"></i>
            {{ 'Livraison : 4,90 € — Gratuite dès 50 €'|t }}
          </p>
        {% endif %}
      {%- endif -%}

      {# Description produit #}
      {%- if product_entity.body.value -%}
        <div class="product-detail__description">
          {{- product.body -}}
        </div>
      {%- endif -%}

      {# Formulaire Add-to-cart / variations / personnalisation #}
      <div class="product-detail__form">
        {{- product|without('title', 'body', 'field_product_images') -}}
      </div>

      {# Réassurance — icônes Phosphor #}
      <ul class="reassurance-list" aria-label="{{ 'Arguments de vente'|t }}">
        <li class="reassurance-list__item">
          <i class="ph ph-lock-simple" aria-hidden="true"></i>
          <span>{{ 'Paiement sécurisé'|t }}</span>
        </li>
        <li class="reassurance-list__item">
          <i class="ph ph-hands-praying" aria-hidden="true"></i>
          <span>{{ 'Fait main en France'|t }}</span>
        </li>
        <li class="reassurance-list__item">
          <i class="ph ph-package" aria-hidden="true"></i>
          <span>{{ 'Expédition sous 24h'|t }}</span>
        </li>
        <li class="reassurance-list__item">
          <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>
          <span>{{ 'Retours sous 14 jours'|t }}</span>
        </li>
      </ul>

    </div>{# /.product-info #}
  </div>{# /.product-layout #}

</article>
