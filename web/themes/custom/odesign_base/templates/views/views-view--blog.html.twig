{#
/**
 * @file
 * views-view--blog.html.twig
 *
 * Surcharge du rendu de la vue Blog.
 * Ajoute la classe .blog-grid sur le wrapper des résultats pour activer la grille CSS.
 */
#}
{% if header %}
  <div class="view-header">
    {{ header }}
  </div>
{% endif %}

{% if exposed %}
  <div class="view-filters">
    {{ exposed }}
  </div>
{% endif %}

{% if rows %}
  <div class="blog-grid">
    {{ rows }}
  </div>
{% elseif empty %}
  <div class="view-empty">
    {{ empty }}
  </div>
{% endif %}

{% if pager %}
  {{ pager }}
{% endif %}

{% if attachment_after %}
  <div class="attachment attachment-after">
    {{ attachment_after }}
  </div>
{% endif %}
