<div{{ attributes.addClass('checkout-order-summary') }}>
  {% block order_items %}
    <table>
      <tbody>
      {% for order_item in order_entity.getItems %}
        <tr>
          <td>{{ order_item.getQuantity|number_format }}&nbsp;x</td>
          {% if order_item.hasPurchasedEntity %}
            <td>
              {{ order_item.getPurchasedEntity|commerce_entity_render('summary') }}
              {% set item_personalizations = odesign_personalizations[order_item.id()] ?? [] %}
              {% if item_personalizations %}
                <div class="checkout-order-summary__personalization">
                  <strong>{{ 'Personnalisation'|t }}</strong>
                  <ul>
                    {% for personalization in item_personalizations %}
                      <li>
                        {{ personalization.label }} :
                        {% if personalization.is_list %}
                          <ul>
                            {% for line in personalization.value %}
                              <li>{{ line }}</li>
                            {% endfor %}
                          </ul>
                        {% else %}
                          {{ personalization.value }}
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </td>
          {% else %}
            <td>{{- order_item.label -}}</td>
          {% endif %}
          <td>{{- order_item.getTotalPrice|commerce_price_format -}}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% endblock %}
  {% block totals %}
    {{ rendered_totals }}
  {% endblock %}
</div>
