<div{{ attributes.addClass('checkout-order-summary') }}>
  {% block order_items %}
    <table>
      <tbody>
      {% for order_item in order_entity.getItems %}
        <tr>
          <td>{{ order_item.getQuantity|number_format }}&nbsp;x</td>
          {% if order_item.hasPurchasedEntity %}
            <td>
              {{ order_item.getPurchasedEntity|commerce_entity_render('summary') }}
              {% if order_item.field_poc_text.value or order_item.field_poc_finish.value or order_item.field_poc_need_upload.value or order_item.field_poc_tree_names.value or order_item.field_poc_tree_wall_mount.value %}
                <div class="checkout-order-summary__personalization">
                  <strong>Personnalisation</strong>
                  <ul>
                    {% if order_item.field_poc_text.value %}
                      <li>Texte : {{ order_item.field_poc_text.value }}</li>
                    {% endif %}
                    {% if order_item.field_poc_finish.value %}
                      <li>Finition : {{ order_item.field_poc_finish.value|capitalize }}</li>
                    {% endif %}
                    {% if order_item.field_poc_need_upload.value %}
                      <li>Fichier client : oui</li>
                    {% endif %}
                    {% if order_item.field_poc_tree_names.value %}
                      {% set tree_names = order_item.field_poc_tree_names.value|replace({"\r": "", ",": "\n"})|split('\n') %}
                      <li>
                        Arbre de vie :
                        <ul>
                          {% for tree_name in tree_names %}
                            {% set cleaned_name = tree_name|trim %}
                            {% if cleaned_name %}
                              <li>{{ cleaned_name }}</li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </li>
                    {% endif %}
                    {% if order_item.field_poc_tree_wall_mount.value %}
                      <li>Attache murale : oui</li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
            </td>
          {% else %}
            <td>{{- order_item.label -}}</td>
          {% endif %}
          <td>{{- order_item.getTotalPrice|commerce_price_format -}}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% endblock %}
  {% block totals %}
    {{ rendered_totals }}
  {% endblock %}
  <p class="order-tva-mention" style="font-size: 0.8em; color: #666; margin-top: 0.5em;">
    {{ 'TVA non applicable, art. 293 B du CGI'|t }}
  </p>
</div>
