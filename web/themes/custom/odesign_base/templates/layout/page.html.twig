{#
/**
 * @file
 * page.html.twig — Template de page principal Atelier O Design
 *
 * Variables :
 * - is_front, logged_in, is_admin
 * - page.header_top, page.header, page.primary_menu
 * - page.highlighted, page.breadcrumb, page.content
 * - page.footer_first/second/third, page.footer_bottom
 */
#}
<!DOCTYPE html>
<html{{ html_attributes.setAttribute('lang', 'fr') }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ head_title|safe_join(' | ') }}</title>
    {# Favicons — générés depuis logo.svg (ico géré par system.theme.global) #}
    <link rel="icon" type="image/svg+xml" href="{{ base_path ~ directory }}/images/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ base_path ~ directory }}/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ base_path ~ directory }}/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ base_path ~ directory }}/images/apple-touch-icon.png">
    <link rel="manifest" href="{{ base_path ~ directory }}/images/site.webmanifest">
    {# Preconnect Google Fonts pour la performance #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes.addClass('layout-no-sidebars', is_admin ? 'page-admin' : '') }}>

    {# Skip link accessibilité #}
    <a href="#main-content" class="skip-link visually-hidden focusable">
      {{ 'Aller au contenu principal'|t }}
    </a>

    {# Barre d'annonce promo (optionnelle — région header_top) #}
    {% if page.header_top %}
      <div class="announcement-bar" role="region" aria-label="{{ 'Informations et promotions'|t }}">
        <div class="container">{{ page.header_top }}</div>
      </div>
    {% else %}
      <div class="announcement-bar" role="region" aria-label="{{ 'Informations livraison'|t }}">
        <div class="container">
          <i class="ph ph-truck" aria-hidden="true"></i>
          <span>{{ 'Livraison gratuite dès 50€ d\'achat'|t }}</span>
        </div>
      </div>
    {% endif %}

    {# Header principal #}
    <header class="site-header" role="banner">
      <div class="site-header__inner">

        {# Logo — lien séparé, jamais wrappé autour de blocs dynamiques #}
        <a href="{{ path('<front>') }}" class="site-logo" title="{{ 'Retour à l\'accueil Atelier O Design'|t }}" aria-label="{{ 'Retour à l\'accueil Atelier O Design'|t }}">
          <img src="{{ base_path ~ directory }}/logo.svg" alt="{{ 'Atelier O Design'|t }}">
        </a>

        {# Blocs optionnels région header (ex: branding personnalisé) #}
        {% if page.header %}
          <div class="site-header__extra">{{ page.header }}</div>
        {% endif %}

        {# Navigation principale (desktop) #}
        {% if page.primary_menu %}
          <nav id="main-navigation"
               class="site-nav"
               role="navigation"
               aria-label="{{ 'Navigation principale'|t }}">
            {{ page.primary_menu }}
          </nav>
        {% endif %}

        {# Actions header : compte client + panier #}
        <div class="site-header__actions">
          {# Connexion / espace personnel #}
          {% if not logged_in %}
            <div class="header-account">
              <a href="{{ path('user.login') }}" class="header-login-link" aria-label="{{ 'Se connecter à votre espace'|t }}">
                <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="header-login-link__label">{{ 'Connexion'|t }}</span>
              </a>
              {% if user_register_url is defined %}
                <a href="{{ user_register_url }}" class="header-register-link" aria-label="{{ 'Créer un compte client'|t }}">
                  {{ 'S\'inscrire'|t }}
                </a>
              {% endif %}
            </div>
          {% else %}
            {# Menu déroulant — différencié client / gestionnaire #}
            <div class="header-account header-account--connected" data-account-menu>
              <button class="header-login-link header-login-link--connected"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls="account-menu"
                      aria-label="{{ is_gestionnaire ? 'Menu espace gestionnaire'|t : 'Menu mon compte'|t }}">
                <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="header-login-link__label">{{ is_gestionnaire ? 'Mon espace'|t : 'Mon compte'|t }}</span>
                <svg class="header-account__chevron" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <ul id="account-menu" class="header-account__dropdown" role="menu" hidden>
                {% if is_gestionnaire %}
                  <li role="none"><a href="{{ path('odesign_admin.dashboard') }}" role="menuitem">{{ 'Tableau de bord'|t }}</a></li>
                {% else %}
                  <li role="none"><a href="{{ user_orders_url }}" role="menuitem">{{ 'Mes commandes'|t }}</a></li>
                  <li role="none"><a href="{{ user_profile_url }}" role="menuitem">{{ 'Mon profil'|t }}</a></li>
                {% endif %}
                <li role="none" class="header-account__dropdown-separator">
                  <a href="{{ user_logout_url }}" role="menuitem" class="header-account__logout">{{ 'Se déconnecter'|t }}</a>
                </li>
              </ul>
            </div>
          {% endif %}

          {# Panier — lien direct avec badge compteur d'articles #}
          <a href="{{ path('commerce_cart.page') }}"
             class="btn btn--ghost header-cart{% if cart_count > 0 %} header-cart--has-items{% endif %}"
             aria-label="{{ cart_count > 0 ? cart_count ~ ' article' ~ (cart_count > 1 ? 's' : '') ~ ' dans votre panier'|t : 'Voir le panier (vide)'|t }}">
            <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            {% if cart_count > 0 %}
              <span class="cart-count" aria-hidden="true">{{ cart_count > 99 ? '99+' : cart_count }}</span>
            {% endif %}
          </a>

          {# Bouton hamburger mobile #}
          <button class="nav-toggle"
                  id="nav-toggle"
                  aria-controls="main-navigation"
                  aria-expanded="false"
                  aria-label="{{ 'Ouvrir le menu de navigation'|t }}">
            <svg class="nav-toggle__icon-open" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <svg class="nav-toggle__icon-close" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

      </div>
    </header>

    {# Messages de statut Drupal #}
    {% if page.highlighted %}
      <div class="highlighted" role="alert" aria-live="polite">
        {{ page.highlighted }}
      </div>
    {% endif %}

    {# Fil d'Ariane — le template breadcrumb.html.twig gère le <nav> #}
    {% if page.breadcrumb and not is_front %}
      <div class="breadcrumb-wrapper container">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    {# Contenu principal #}
    <main id="main-content" class="main-content" role="main" tabindex="-1">
      {% if is_front and front_life_occasion_cards is defined and front_life_occasion_cards %}
        <section
          class="home-hero{{ front_hero_has_image ? ' home-hero--with-image home-hero--text-' ~ front_hero_text_mode : '' }}"
          {% if front_hero_image_url %}
            style="--home-hero-image: url('{{ front_hero_image_url|e('html_attr') }}');"
          {% endif %}
        >
          <div class="container home-hero__inner">
            <div class="home-hero__content">
              <p class="home-hero__eyebrow">{{ 'Atelier O Design'|t }}</p>
              <h1 class="home-hero__title">
                {{ 'Des créations en bois personnalisées pour les moments qui comptent.'|t }}
              </h1>
              <p class="home-hero__intro">
                {{ 'Bois gravé, découpé, personnalisé à votre image — pour les mariages, les naissances et tous les moments qui méritent un cadeau unique.'|t }}
              </p>
              <div class="home-hero__actions">
                <a href="#home-universes" class="btn btn--primary">{{ 'Voir les univers'|t }}</a>
                <a href="{{ front_catalogue_url }}" class="btn btn--secondary">{{ 'Voir tout le catalogue'|t }}</a>
              </div>
            </div>

            <aside class="home-hero__panel" aria-label="{{ 'Points forts Atelier O Design'|t }}">
              <ul class="home-hero__highlights">
                <li>{{ 'Atelier réel, fabrication soignée et personnalisations lisibles.'|t }}</li>
                <li>{{ 'Univers pensés pour le mariage, la naissance et les cadeaux personnalisés.'|t }}</li>
                <li>{{ 'Chaque création est réalisée avec soin dans notre atelier, en France.'|t }}</li>
              </ul>
            </aside>
          </div>
        </section>


        <section id="home-universes" class="home-universes">
          <div class="container">
            <div class="section-heading">
              <div>
                <h2 class="section-heading__title">{{ 'Choisir par occasion de vie'|t }}</h2>
              </div>
              <p class="section-heading__meta">
                
              </p>
            </div>

            <div class="life-occasion-cards">
              {% for card in front_life_occasion_cards %}
                <article class="life-occasion-card">
                  {% if card.preview_image_url %}
                    <a href="{{ card.url }}" class="life-occasion-card__media">
                      <img
                        src="{{ card.preview_image_url }}"
                        alt="{{ card.title }}"
                        {% if loop.first %}
                          loading="eager"
                          fetchpriority="high"
                        {% else %}
                          loading="lazy"
                          decoding="async"
                        {% endif %}
                      >
                    </a>
                  {% endif %}

                  <div class="life-occasion-card__header">
                    <h3 class="life-occasion-card__title">
                      <a href="{{ card.url }}">{{ card.title }}</a>
                    </h3>
                    {% if card.product_count %}
                      <p class="life-occasion-card__count">
                        {{ '@count produit(s)'|t({'@count': card.product_count}) }}
                      </p>
                    {% endif %}
                  </div>

                  {% if card.intro %}
                    <p class="life-occasion-card__intro">{{ card.intro }}</p>
                  {% endif %}

                  {% if card.reassurance_items %}
                    <ul class="life-occasion-card__reassurance">
                      {% for item in card.reassurance_items %}
                        <li>{{ item }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  <div class="life-occasion-card__actions">
                    <a href="{{ card.url }}" class="btn btn--secondary">{{ 'Explorer cet univers'|t }}</a>
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        </section>

        <section class="home-story-proof">
          <div class="container">
            <div class="home-story-proof__grid">
              <article class="home-story-proof__card home-story-proof__card--founder">
                <figure class="home-story-proof__media">
                  <img
                    src="{{ front_story_founder_image_url ?: (base_path ~ directory ~ '/media/home-je-me-presente.jpg') }}"
                    alt="{{ 'Océane dans son atelier O Design'|t }}"
                    loading="lazy"
                    width="1500"
                    height="2000"
                  >
                </figure>
                <div class="home-story-proof__content">
                  <p class="section-heading__eyebrow">{{ 'Je me présente'|t }}</p>
                  <h2 class="section-heading__title">{{ front_story_founder_title }}</h2>
                  {% for paragraph in front_story_founder_text_lines %}
                    <p>{{ paragraph }}</p>
                  {% endfor %}
                </div>
              </article>

              <article class="home-story-proof__card home-story-proof__card--video">
                <div class="home-story-proof__content">
                  <p class="section-heading__eyebrow">{{ 'Dans les coulisses'|t }}</p>
                  <h2 class="section-heading__title">{{ front_story_video_title }}</h2>
                  <p>{{ front_story_video_text }}</p>
                </div>
                <figure class="home-story-proof__video-wrap">
                  <video
                    class="home-story-proof__video"
                    controls
                    preload="metadata"
                    poster="{{ front_story_video_poster_url ?: (base_path ~ directory ~ '/media/home-arbre-vie-poster.jpg') }}"
                  >
                    <source src="{{ front_story_video_file_url ?: (base_path ~ directory ~ '/media/home-arbre-vie-realisation.mp4') }}" type="video/mp4">
                  </video>
                </figure>
              </article>
            </div>
          </div>
        </section>

        <section class="home-bridge">
          <div class="container">
            <div class="home-bridge__grid">
              <article class="home-bridge__card">
                <p class="section-heading__eyebrow">{{ 'Collections phares'|t }}</p>
                <h2 class="section-heading__title">{{ 'Retrouvez vite vos univers'|t }}</h2>
                <p class="home-bridge__intro">{{ 'Accès rapide vers les univers les plus recherchés, pour limiter les clics et garder une navigation simple.'|t }}</p>
                <ul class="home-bridge__links">
                  {% for item in front_featured_life_occasions %}
                    <li>
                      <a href="{{ item.url }}" class="home-bridge__link">
                        <span>{{ item.title }}</span>
                        <span aria-hidden="true">›</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </article>

              <article class="home-bridge__card">
                <p class="section-heading__eyebrow">{{ 'Conseils & idées'|t }}</p>
                <h2 class="section-heading__title">{{ 'Derniers articles du blog'|t }}</h2>
                <p class="home-bridge__intro">{{ 'Des idées cadeau, des inspirations et des coulisses pour rassurer et aider les clients à choisir.'|t }}</p>
                {% if front_latest_articles %}
                  <div class="home-bridge__articles">
                    {% for article in front_latest_articles %}
                      <div class="home-bridge__article">
                        {% if article.image_url %}
                          <a href="{{ article.url }}" class="home-bridge__article-media">
                            <img
                              src="{{ article.image_url }}"
                              alt="{{ article.image_alt }}"
                              loading="lazy"
                              decoding="async"
                            >
                          </a>
                        {% endif %}
                        <h3 class="home-bridge__article-title">
                          <a href="{{ article.url }}">{{ article.title }}</a>
                        </h3>
                        {% if article.excerpt %}
                          <p class="home-bridge__article-excerpt">{{ article.excerpt }}</p>
                        {% endif %}
                        <a href="{{ article.url }}" class="home-bridge__article-link">{{ 'Lire l\'article'|t }}</a>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <p class="home-bridge__empty">{{ 'Les prochains articles apparaîtront ici automatiquement.'|t }}</p>
                {% endif %}
              </article>
            </div>
          </div>
        </section>

        {# Section "Comment ça marche" — 3 étapes du processus de commande #}
        {% if front_methode_steps %}
          <section class="home-methode" aria-labelledby="home-methode-title">
            <div class="container">
              <div class="section-heading section-heading--center">
                <h2 class="section-heading__title" id="home-methode-title">{{ front_methode_title }}</h2>
                {% if front_methode_subtitle %}
                  <p class="section-heading__meta">{{ front_methode_subtitle }}</p>
                {% endif %}
              </div>
              <ol class="home-methode__steps" role="list">
                {% for step in front_methode_steps %}
                  <li class="home-methode__step">
                    <div class="home-methode__step-num" aria-hidden="true">{{ step.num }}</div>
                    <div class="home-methode__step-icon" aria-hidden="true">
                      <i class="ph {{ step.icon }}"></i>
                    </div>
                    <h3 class="home-methode__step-title">{{ step.title }}</h3>
                    <p class="home-methode__step-desc">{{ step.desc }}</p>
                  </li>
                {% endfor %}
              </ol>
              <div class="home-methode__cta">
                <a href="/produits" class="btn btn--primary">{{ 'Voir nos créations'|t }}</a>
              </div>
            </div>
          </section>
        {% endif %}

      {% else %}
        <div class="container">
          {% if is_contact_page %}
            <section class="contact-hero" aria-label="{{ 'Contacter Atelier O Design'|t }}">
              <div class="contact-hero__content">
                <p class="contact-hero__eyebrow">{{ 'Atelier O Design'|t }}</p>
                <h1 class="contact-hero__title">{{ 'Parlons de votre création personnalisée'|t }}</h1>
                <p class="contact-hero__intro">
                  {{ 'Une question sur un produit, une personnalisation ou un délai ? Nous vous répondons rapidement.'|t }}
                </p>
              </div>
              <div class="contact-hero__actions">
                <a href="#contact-form" class="btn btn--primary">{{ 'Envoyer un message'|t }}</a>
                <a href="{{ contact_catalogue_url }}" class="btn btn--secondary">{{ 'Voir le catalogue'|t }}</a>
              </div>
              <div class="contact-hero__quick">
                <article class="contact-hero__card">
                  <h2>{{ 'Formulaire'|t }}</h2>
                  <p>{{ 'Remplissez le formulaire ci-dessous.'|t }}</p>
                </article>
                <article class="contact-hero__card">
                  <h2>{{ 'Réponse'|t }}</h2>
                  <p>{{ 'En général sous 24h ouvrées.'|t }}</p>
                </article>
                <article class="contact-hero__card">
                  <h2>{{ 'Besoin précis'|t }}</h2>
                  <p>{{ 'Indiquez le produit, le texte et la date souhaitée.'|t }}</p>
                </article>
              </div>

              {% if contact_form is defined %}
                <div id="contact-form" class="contact-hero__form">
                  <h2 class="contact-hero__form-title">{{ 'Envoyer un message'|t }}</h2>
                  {{ contact_form }}
                </div>
              {% endif %}
            </section>
          {% endif %}
          {% if is_catalogue_page %}
            <section class="catalogue-assist" aria-label="{{ 'Aide choix produit'|t }}">
              <p class="catalogue-assist__lead">
                {{ 'Besoin d\'aide pour choisir ou personnaliser un produit ?'|t }}
              </p>
              <a href="{{ catalogue_contact_url }}" class="catalogue-assist__link">{{ 'Contacter l\'atelier'|t }}</a>
            </section>
          {% endif %}
          {{ page.content }}
        </div>
      {% endif %}
    </main>

    {# Bandeau newsletter — affiché sur toutes les pages publiques #}
    {% if newsletter_form %}
      <section class="newsletter-strip" aria-label="{{ 'Inscription à la newsletter'|t }}">
        <div class="container">
          <div class="newsletter-strip__inner">
            <div class="newsletter-strip__text">
              <h2 class="newsletter-strip__title">{{ 'Restez inspirée'|t }}</h2>
              <p class="newsletter-strip__desc">{{ 'Recevez nos nouvelles créations, offres exclusives et actualités de l\'atelier directement dans votre boîte mail.'|t }}</p>
            </div>
            <div class="newsletter-strip__form">
              {{ newsletter_form }}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    {# Footer #}
    <footer class="site-footer" role="contentinfo">
      <div class="container">

        {% if page.footer_first or page.footer_second or page.footer_third %}
          <div class="site-footer__columns">
            {% if page.footer_first %}
              <div class="site-footer__col">{{ page.footer_first }}</div>
            {% endif %}
            {% if page.footer_second %}
              <div class="site-footer__col">{{ page.footer_second }}</div>
            {% endif %}
            {% if page.footer_third %}
              <div class="site-footer__col">{{ page.footer_third }}</div>
            {% endif %}
          </div>
        {% endif %}

        <div class="site-footer__bottom">
          <nav class="site-footer__links" aria-label="{{ 'Liens légaux'|t }}">
            <a href="/contact">{{ 'Contact'|t }}</a>
            <a href="/cgv">{{ 'CGV'|t }}</a>
            <a href="/mentions-legales">{{ 'Mentions légales'|t }}</a>
            <a href="/politique-confidentialite">{{ 'Politique de confidentialité'|t }}</a>
          </nav>
          <p class="site-footer__copyright">
            &copy; {{ 'now'|date('Y') }} Atelier O Design. {{ 'Tous droits réservés.'|t }}
          </p>
          <p class="site-footer__legal-notice">
            {{ 'TVA non applicable — franchise en base de TVA, art. 293 B du CGI.'|t }}
          </p>
        </div>

      </div>
    </footer>

    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
