{#
/**
 * @file
 * page--system--403.html.twig
 *
 * Page "403 — Accès refusé" branded O'Design Création.
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ 'Accès refusé | O'Design Création'|t }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    <a href="#main-content" class="visually-hidden focusable skip-link">
      {{ 'Aller au contenu principal'|t }}
    </a>

    {{ page.header }}

    <main id="main-content" class="site-main" role="main">
      <div class="container">
        <section class="error-page error-page--403" aria-labelledby="error-page-title">
          <div class="error-page__inner">
            <p class="error-page__code" aria-hidden="true">403</p>
            <h1 id="error-page-title" class="error-page__title">
              {{ 'Accès non autorisé'|t }}
            </h1>
            <p class="error-page__desc">
              {{ 'Vous n\'avez pas les permissions nécessaires pour accéder à cette page.'|t }}
            </p>
            <div class="error-page__actions">
              <a href="/" class="btn btn--primary">{{ 'Retour à l\'accueil'|t }}</a>
              <a href="/user/login" class="btn btn--secondary">{{ 'Se connecter'|t }}</a>
            </div>
          </div>
        </section>
      </div>
    </main>

    {{ page.footer }}

    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
