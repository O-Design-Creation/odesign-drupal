# Playwright — variables d'environnement pour les scripts d'audit visuel
# Copier ce fichier : cp playwright/.env.playwright.example playwright/.env.playwright
# Puis charger     : export $(cat playwright/.env.playwright | xargs)
#
# NE PAS committer playwright/.env.playwright (gitignored)

PLAYWRIGHT_BASE=https://odesign-drupal.ddev.site
PLAYWRIGHT_USER=gestionnaire_username
PLAYWRIGHT_PASS=your_password_here
PLAYWRIGHT_OUTDIR=/tmp/screenshots
